{
	"name": "School Income Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "p_schoolincome_d",
						"type": "DatasetReference"
					},
					"name": "parquetsource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DataverseSchoolIncomeExpenses",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "alterRow1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          tcbgrow_amount as long,",
				"          tcbgrow_asofdate as timestamp,",
				"          tcbgrow_description as string,",
				"          tcbgrow_schoolid as long,",
				"          tcbgrow_importincomeid as decimal(38,9),",
				"          tcbgrow_transactiontype as integer,",
				"          tcbgrow_month as integer,",
				"          tcbgrow_source as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> parquetsource",
				"derivedColumn1 alterRow(upsertIf(true())) ~> alterRow1",
				"parquetsource derive({tcbgrow_School@odata.bind} = iif(    isNull(tcbgrow_schoolid),    toString(null()),    concat(\"/tcbgrow_schools(tcbgrow_appid=\", toString(tcbgrow_schoolid), \")\")),",
				"          tcbgrow_importincomeid = toInteger(tcbgrow_importincomeid)) ~> derivedColumn1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'tcbgrow_import_income_key',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     outputAssertFailedRows: true,",
				"     assertFailure_fileSystem: 'giraffe',",
				"     assertFailure_folderPath: 'errors',",
				"     mapColumn(",
				"          tcbgrow_amount,",
				"          tcbgrow_asofdate,",
				"          tcbgrow_description,",
				"          tcbgrow_importincomeid,",
				"          tcbgrow_month,",
				"          tcbgrow_source,",
				"          {tcbgrow_School@odata.bind},",
				"          tcbgrow_transactiontype",
				"     )) ~> sink1"
			]
		}
	}
}