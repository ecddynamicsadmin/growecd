{
	"name": "CRM App User Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet_app_users",
						"type": "DatasetReference"
					},
					"name": "ParquetAppUser"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "CRM_Application_Users",
						"type": "DatasetReference"
					},
					"name": "SinkRegions"
				}
			],
			"transformations": [
				{
					"name": "Upsert"
				},
				{
					"name": "DerivedColumns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cog_firstname as string,",
				"          cog_lastname as string,",
				"          cog_userid as integer,",
				"          cog_lastlogin as timestamp,",
				"          cog_giraffeupdatedon as timestamp,",
				"          overriddencreatedon as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> ParquetAppUser",
				"DerivedColumns alterRow(upsertIf(true())) ~> Upsert",
				"ParquetAppUser derive(cog_name = concat(cog_firstname,\" \",cog_lastname)) ~> DerivedColumns",
				"Upsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'cog_userid',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     mapColumn(",
				"          cog_firstname,",
				"          cog_lastname,",
				"          cog_userid,",
				"          cog_lastlogin,",
				"          cog_giraffeupdatedon,",
				"          overriddencreatedon,",
				"          cog_name",
				"     )) ~> SinkRegions"
			]
		}
	}
}