{
	"name": "CRM Centre Profiles Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet_Centre_Profiles",
						"type": "DatasetReference"
					},
					"name": "ParquetCentreProfiles"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "CRM_Contacts",
						"type": "DatasetReference"
					},
					"name": "SinkContacts"
				}
			],
			"transformations": [
				{
					"name": "Upsert"
				},
				{
					"name": "DerivedColumns"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          mobilephone as string,",
				"          emailaddress1 as string,",
				"          firstname as string,",
				"          lastname as string,",
				"          birthdate as timestamp,",
				"          cog_gendercode as byte,",
				"          cog_racecode as byte,",
				"          cog_raceother as string,",
				"          address1_city as string,",
				"          address1_line1 as string,",
				"          cog_countryid as string,",
				"          cog_region as string,",
				"          cog_giraffeprofileid as integer,",
				"          parentcustomerid_account as integer,",
				"          cog_rolecode as byte,",
				"          cog_startdate as timestamp,",
				"          cog_childprotectionclearancecode as byte,",
				"          cog_employmenttypecode as byte,",
				"          cog_highestqualificationcode as byte,",
				"          cog_workhourstotal as integer,",
				"          cog_giraffeupdatedon as timestamp,",
				"          overriddencreatedon as timestamp,",
				"          cog_applicationuser as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> ParquetCentreProfiles",
				"filter1 alterRow(upsertIf(true())) ~> Upsert",
				"ParquetCentreProfiles derive({cog_CountryId@odata.bind} = iif(\r",
				"    isNull(cog_countryid),\r",
				"    toString(null()),\r",
				"    concat(\"/cog_countries(cog_countrycode='\",toString(cog_countryid),\"')\")\r",
				"),",
				"          {cog_Region@odata.bind} = iif(\r",
				"    isNull(cog_region),\r",
				"    toString(null()),\r",
				"    concat(\"/cog_regions(cog_regioncode='\",toString(cog_region),\"')\")\r",
				"),",
				"          {cog_ApplicationUser@odata.bind} = iif(     isNull(cog_applicationuser),     toString(null()),     concat(\"/cog_applicationusers(cog_userid=\",toString(cog_applicationuser),\")\") ),",
				"          {parentcustomerid_account@odata.bind} = iif(     isNull(parentcustomerid_account),     toString(null()),     concat(\"/accounts(cog_centreid=\",toString(parentcustomerid_account),\")\") ),",
				"          overriddencreatedon = toString(toUTC(cog_startdate, 'Africa/Johannesburg'), \"yyyy-MM-dd'T'HH:mm:ss'Z'\"),",
				"          cog_startdate = toString(toDate(cog_startdate), 'yyyy-MM-dd'),",
				"          cog_giraffeupdatedon = toString(toUTC(cog_giraffeupdatedon, 'Africa/Johannesburg'), \"yyyy-MM-dd'T'HH:mm:ss'Z'\"),",
				"          cog_racecode = iif(\r",
				"  isNull(cog_racecode) || trim(toString(cog_racecode)) == '',\r",
				"  toInteger(null()),\r",
				"  iif(in(['0','1','2','3','4'], trim(toString(cog_racecode))),\r",
				"      toInteger(trim(toString(cog_racecode))),\r",
				"      99)\r",
				"),",
				"          cog_raceother = iif(\r",
				"  isNull(cog_raceother) || trim(toString(cog_raceother)) == '' || in(['1','2','3'], trim(toString(cog_raceother))),\r",
				"  toString(null()),\r",
				"  left(trim(toString(cog_raceother)), 255)\r",
				")) ~> DerivedColumns",
				"DerivedColumns filter(equals(parentcustomerid_account,1)\r",
				") ~> filter1",
				"Upsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'cog_centreid',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     mapColumn(",
				"          mobilephone,",
				"          emailaddress1,",
				"          firstname,",
				"          lastname,",
				"          birthdate,",
				"          cog_gendercode,",
				"          cog_racecode,",
				"          cog_raceother,",
				"          address1_city,",
				"          address1_line1,",
				"          cog_countryid,",
				"          cog_region,",
				"          cog_giraffeprofileid,",
				"          parentcustomerid_account,",
				"          cog_rolecode,",
				"          cog_startdate,",
				"          cog_childprotectionclearancecode,",
				"          cog_employmenttypecode,",
				"          cog_highestqualificationcode,",
				"          cog_workhourstotal,",
				"          cog_giraffeupdatedon,",
				"          overriddencreatedon,",
				"          cog_applicationuser,",
				"          {cog_CountryId@odata.bind},",
				"          {cog_Region@odata.bind},",
				"          {cog_ApplicationUser@odata.bind},",
				"          {parentcustomerid_account@odata.bind}",
				"     )) ~> SinkContacts"
			]
		}
	}
}