{
	"name": "CRM Centre Profiles Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet_Centre_Profiles",
						"type": "DatasetReference"
					},
					"name": "ParquetCentreProfiles"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "CRM_Centres",
						"type": "DatasetReference"
					},
					"name": "SinkContacts"
				}
			],
			"transformations": [
				{
					"name": "Upsert"
				},
				{
					"name": "DerivedColumns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          mobilephone as string,",
				"          emailaddress1 as string,",
				"          firstname as string,",
				"          lastname as string,",
				"          birthdate as timestamp,",
				"          cog_gendercode as byte,",
				"          cog_racecode as byte,",
				"          cog_raceother as string,",
				"          address1_city as string,",
				"          address1_line1 as string,",
				"          cog_countryid as string,",
				"          cog_region as string,",
				"          cog_giraffeprofileid as integer,",
				"          centreid as integer,",
				"          cog_rolecode as byte,",
				"          cog_startdate as timestamp,",
				"          cog_childprotectionclearancecode as byte,",
				"          cog_employmenttypecode as byte,",
				"          cog_highestqualificationcode as byte,",
				"          cog_workhourstotal as integer,",
				"          cog_giraffeupdatedon as timestamp,",
				"          overriddencreatedon as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> ParquetCentreProfiles",
				"DerivedColumns alterRow(upsertIf(true())) ~> Upsert",
				"ParquetCentreProfiles derive({cog_CountryId@odata.bind} = iif(\r",
				"    isNull(cog_countryid),\r",
				"    toString(null()),\r",
				"    concat(\"/cog_countries(cog_countrycode='\",toString(cog_countryid),\"')\")\r",
				"),",
				"          {cog_Region@odata.bind} = iif(\r",
				"    isNull(cog_region),\r",
				"    toString(null()),\r",
				"    concat(\"/cog_regions(cog_regioncode='\",toString(cog_region),\"')\")\r",
				"),",
				"          overriddencreatedon = toString(toUTC(cog_startdate, 'Africa/Johannesburg'), \"yyyy-MM-dd'T'HH:mm:ss'Z'\"),",
				"          cog_centrestartdate = toString(toDate(birthdate), 'yyyy-MM-dd'),",
				"          cog_giraffeupdatedon = toString(toUTC(cog_startdate, 'Africa/Johannesburg'), \"yyyy-MM-dd'T'HH:mm:ss'Z'\"),",
				"          cog_classtypecode = iif(\r",
				"  size(filter(split(regexReplace(toString(cog_gendercode), '[\\\\[\\\\]\\\\s\"]', ''), ','), in(['1','2','3','4','5','6','7'], #item))) == 0,\r",
				"  toString(null()),\r",
				"  reduce(\r",
				"    filter(split(regexReplace(toString(cog_gendercode), '[\\\\[\\\\]\\\\s\"]', ''), ','), in(['1','2','3','4','5','6','7'], #item)),\r",
				"    '',\r",
				"    iif(#acc == '', #item, #acc + ',' + #item),\r",
				"    #result\r",
				"  )\r",
				"),",
				"          cog_centretypecode = iif(\r",
				"  isNull(cog_gendercode) || trim(toString(cog_gendercode)) == '',\r",
				"  toInteger(null()),\r",
				"  iif(in(['1','2','3','4','5'], trim(toString(cog_gendercode))),\r",
				"      toInteger(trim(toString(cog_gendercode))),\r",
				"      6)\r",
				"),",
				"          cog_centretypeother = iif(\r",
				"  isNull(cog_raceother) || trim(toString(cog_raceother)) == '' || in(['1','2','3','4','5'], trim(toString(cog_raceother))),\r",
				"  toString(null()),\r",
				"  left(trim(toString(cog_raceother)), 255)\r",
				"),",
				"          cog_propertytypecode = iif(\r",
				"  isNull(cog_gendercode) || trim(toString(cog_gendercode)) == '',\r",
				"  toInteger(null()),\r",
				"  iif(in(['1','2','3'], trim(toString(cog_gendercode))),\r",
				"      toInteger(trim(toString(cog_gendercode))),\r",
				"      99)\r",
				"),",
				"          cog_propertytypeother = iif(\r",
				"  isNull(cog_gendercode) || trim(toString(cog_gendercode)) == '' || in(['1','2','3'], trim(toString(cog_gendercode))),\r",
				"  toString(null()),\r",
				"  left(trim(toString(cog_gendercode)), 255)\r",
				")) ~> DerivedColumns",
				"Upsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'cog_centreid',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     mapColumn(",
				"          mobilephone,",
				"          emailaddress1,",
				"          firstname,",
				"          lastname,",
				"          birthdate,",
				"          cog_gendercode,",
				"          cog_racecode,",
				"          cog_raceother,",
				"          address1_city,",
				"          address1_line1,",
				"          cog_countryid,",
				"          cog_region,",
				"          cog_giraffeprofileid,",
				"          cog_centreid,",
				"          cog_rolecode,",
				"          cog_startdate,",
				"          cog_childprotectionclearancecode,",
				"          cog_employmenttypecode,",
				"          cog_highestqualificationcode,",
				"          cog_workhourstotal,",
				"          bind = {cog_CountryId@odata.bind},",
				"          bind = {cog_Region@odata.bind},",
				"          overriddencreatedon,",
				"          cog_centrestartdate,",
				"          cog_giraffeupdatedon,",
				"          cog_classtypecode,",
				"          cog_centretypecode,",
				"          cog_centretypeother,",
				"          cog_propertytypecode,",
				"          cog_propertytypeother",
				"     )) ~> SinkContacts"
			]
		}
	}
}