{
	"name": "School Compliance Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "p_schoolcompliance_d",
						"type": "DatasetReference"
					},
					"name": "parquetsource"
				},
				{
					"dataset": {
						"referenceName": "p_schoolcompliance_d",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DataverseCompliance",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "alterRow1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				},
				{
					"name": "parse1"
				},
				{
					"name": "unpivot1"
				},
				{
					"name": "flatten1"
				},
				{
					"name": "unpivot2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          tcbgrow_amountid as long,",
				"          tcbgrow_appid as long,",
				"          tcbgrow_checklistholder as string,",
				"          tcbgrow_dsdapplicationsubmission as timestamp,",
				"          tcbgrow_dsdgrantapproval as string,",
				"          tcbgrow_dsdgrantpaid as string,",
				"          tcbgrow_dsdstatus as string,",
				"          tcbgrow_effectivedate as timestamp,",
				"          tcbgrow_eligibleforotherstudy as string,",
				"          tcbgrow_expirydate as timestamp,",
				"          tcbgrow_franchisecommencementdate as timestamp,",
				"          tcbgrow_nporegistered as string,",
				"          tcbgrow_nporegistrationdate as timestamp,",
				"          tcbgrow_nporegistrationnumber as string,",
				"          tcbgrow_numberofchildrensregistration as integer,",
				"          tcbgrow_othersubsidyenddate as timestamp,",
				"          tcbgrow_othersubsidystartdate as timestamp,",
				"          tcbgrow_schoolid as long,",
				"          tcbgrow_schoolcapacity as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> parquetsource",
				"source(output(",
				"          tcbgrow_amountid as long,",
				"          tcbgrow_appid as long,",
				"          tcbgrow_checklistholder as string,",
				"          tcbgrow_dsdapplicationsubmission as timestamp,",
				"          tcbgrow_dsdgrantapproval as string,",
				"          tcbgrow_dsdgrantpaid as string,",
				"          tcbgrow_dsdstatus as string,",
				"          tcbgrow_effectivedate as timestamp,",
				"          tcbgrow_eligibleforotherstudy as string,",
				"          tcbgrow_expirydate as timestamp,",
				"          tcbgrow_franchisecommencementdate as timestamp,",
				"          tcbgrow_nporegistered as string,",
				"          tcbgrow_nporegistrationdate as timestamp,",
				"          tcbgrow_nporegistrationnumber as string,",
				"          tcbgrow_numberofchildrensregistration as integer,",
				"          tcbgrow_othersubsidyenddate as timestamp,",
				"          tcbgrow_othersubsidystartdate as timestamp,",
				"          tcbgrow_schoolid as long,",
				"          tcbgrow_schoolcapacity as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> source1",
				"derivedColumn1 alterRow(upsertIf(true())) ~> alterRow1",
				"parquetsource derive({tcbgrow_School@odata.bind} = iif(    isNull(tcbgrow_schoolid),    toString(null()),    concat(\"/tcbgrow_schools(tcbgrow_appid=\", toString(tcbgrow_schoolid), \")\"))) ~> derivedColumn1",
				"source1 select(mapColumn(",
				"          tcbgrow_appid,",
				"          tcbgrow_checklistholder",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 parse(parsed = tcbgrow_checklistholder ? (business_plan as boolean,",
				"     disciplinary_policy as boolean,",
				"     lease_agreement as boolean,",
				"     npo_certificate as boolean,",
				"     building_plan as boolean,",
				"     emergency_plan as boolean,",
				"     zoning_certificate as boolean,",
				"     constitution as boolean,",
				"     form29 as boolean,",
				"     form30 as boolean,",
				"     fire_safety as boolean,",
				"     health_clearance as boolean,",
				"     form16 as boolean,",
				"     form17 as boolean,",
				"     western_cape as boolean,",
				"     kwa_zulu_natal as boolean)[],",
				"     format: 'json',",
				"     documentForm: 'singleDocument') ~> parse1",
				"flatten1 unpivot(output(",
				"          checklist_item as string,",
				"          business_plan as boolean,",
				"          disciplinary_policy as boolean,",
				"          lease_agreement as boolean",
				"     ),",
				"     ungroupBy(tcbgrow_appid),",
				"     lateral: true,",
				"     ignoreNullPivots: false) ~> unpivot1",
				"unpivot2 foldDown(unroll(parsed),",
				"     mapColumn(",
				"          business_plan = parsed.business_plan,",
				"          tcbgrow_appid,",
				"          disciplinary_policy = parsed.disciplinary_policy,",
				"          lease_agreement = parsed.lease_agreement,",
				"          npo_certificate = parsed.npo_certificate,",
				"          building_plan = parsed.building_plan,",
				"          emergency_plan = parsed.emergency_plan,",
				"          zoning_certificate = parsed.zoning_certificate,",
				"          constitution = parsed.constitution,",
				"          form29 = parsed.form29,",
				"          form30 = parsed.form30,",
				"          fire_safety = parsed.fire_safety,",
				"          health_clearance = parsed.health_clearance,",
				"          form16 = parsed.form16,",
				"          form17 = parsed.form17,",
				"          western_cape = parsed.western_cape,",
				"          kwa_zulu_natal = parsed.kwa_zulu_natal",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten1",
				"parse1 unpivot(output(",
				"          items as boolean,",
				"          parsed as (business_plan as boolean, disciplinary_policy as boolean, lease_agreement as boolean, npo_certificate as boolean, building_plan as boolean, emergency_plan as boolean, zoning_certificate as boolean, constitution as boolean, form29 as boolean, form30 as boolean, fire_safety as boolean, health_clearance as boolean, form16 as boolean, form17 as boolean, western_cape as boolean, kwa_zulu_natal as boolean)[]",
				"     ),",
				"     ungroupBy(tcbgrow_appid),",
				"     lateral: true,",
				"     ignoreNullPivots: false) ~> unpivot2",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'tcbgrow_import_key',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     outputAssertFailedRows: true,",
				"     assertFailure_fileSystem: 'giraffe',",
				"     assertFailure_folderPath: 'errors',",
				"     mapColumn(",
				"          tcbgrow_amount = tcbgrow_amountid,",
				"          tcbgrow_appid,",
				"          tcbgrow_checklistholder,",
				"          tcbgrow_dsdapplicationsubmissiondate = tcbgrow_dsdapplicationsubmission,",
				"          tcbgrow_dsdgrantapproval,",
				"          tcbgrow_dsdgrantpaid,",
				"          tcbgrow_dsdstatus,",
				"          tcbgrow_effectivedate,",
				"          tcbgrow_eligibleforotherstudy,",
				"          tcbgrow_expirydate,",
				"          tcbgrow_franchisecommencementdate,",
				"          tcbgrow_nporegistered,",
				"          tcbgrow_nporegistrationdate,",
				"          tcbgrow_nporegistrationnumber,",
				"          tcbgrow_numberofchildrensregistration,",
				"          tcbgrow_othersubsidyenddate,",
				"          tcbgrow_othersubsidystartdate,",
				"          tcbgrow_schoolcapacity,",
				"          {tcbgrow_School@odata.bind}",
				"     )) ~> sink1"
			]
		}
	}
}