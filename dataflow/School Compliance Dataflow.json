{
	"name": "School Compliance Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "p_schoolcompliance_d",
						"type": "DatasetReference"
					},
					"name": "parquetsource"
				},
				{
					"dataset": {
						"referenceName": "p_schoolcompliance_d",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "DataverseChecklist",
						"type": "DatasetReference"
					},
					"name": "checklist"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DataverseCompliance",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					}
				},
				{
					"dataset": {
						"referenceName": "DataverseRegistrationStatusChecklist",
						"type": "DatasetReference"
					},
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "alterRow1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				},
				{
					"name": "parse1"
				},
				{
					"name": "select2"
				},
				{
					"name": "unpivot1"
				},
				{
					"name": "select3"
				},
				{
					"name": "filter1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "select4"
				},
				{
					"name": "select5"
				},
				{
					"name": "alterRow2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          tcbgrow_amountid as long,",
				"          tcbgrow_appid as long,",
				"          tcbgrow_checklistholder as string,",
				"          tcbgrow_dsdapplicationsubmission as timestamp,",
				"          tcbgrow_dsdgrantapproval as string,",
				"          tcbgrow_dsdgrantpaid as string,",
				"          tcbgrow_dsdstatus as string,",
				"          tcbgrow_effectivedate as timestamp,",
				"          tcbgrow_eligibleforotherstudy as string,",
				"          tcbgrow_expirydate as timestamp,",
				"          tcbgrow_franchisecommencementdate as timestamp,",
				"          tcbgrow_nporegistered as string,",
				"          tcbgrow_nporegistrationdate as timestamp,",
				"          tcbgrow_nporegistrationnumber as string,",
				"          tcbgrow_numberofchildrensregistration as integer,",
				"          tcbgrow_othersubsidyenddate as timestamp,",
				"          tcbgrow_othersubsidystartdate as timestamp,",
				"          tcbgrow_schoolid as long,",
				"          tcbgrow_schoolcapacity as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> parquetsource",
				"source(output(",
				"          tcbgrow_amountid as long,",
				"          tcbgrow_appid as long,",
				"          tcbgrow_checklistholder as string,",
				"          tcbgrow_dsdapplicationsubmission as timestamp,",
				"          tcbgrow_dsdgrantapproval as string,",
				"          tcbgrow_dsdgrantpaid as string,",
				"          tcbgrow_dsdstatus as string,",
				"          tcbgrow_effectivedate as timestamp,",
				"          tcbgrow_eligibleforotherstudy as string,",
				"          tcbgrow_expirydate as timestamp,",
				"          tcbgrow_franchisecommencementdate as timestamp,",
				"          tcbgrow_nporegistered as string,",
				"          tcbgrow_nporegistrationdate as timestamp,",
				"          tcbgrow_nporegistrationnumber as string,",
				"          tcbgrow_numberofchildrensregistration as integer,",
				"          tcbgrow_othersubsidyenddate as timestamp,",
				"          tcbgrow_othersubsidystartdate as timestamp,",
				"          tcbgrow_schoolid as long,",
				"          tcbgrow_schoolcapacity as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> source1",
				"source(output(",
				"          {@odata.etag} as string,",
				"          cog_checklistid as string,",
				"          cog_checklistname as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     query: '<fetch>\\n     <entity name=\"cog_checklist\">\\n          <attribute name=\"cog_checklistid\"/>\\n          <attribute name=\"cog_checklistname\"/>\\n          <order attribute=\"cog_checklistname\" descending=\"false\"/>\\n     </entity>\\n</fetch>') ~> checklist",
				"derivedColumn1 alterRow(upsertIf(true())) ~> alterRow1",
				"parquetsource derive({tcbgrow_School@odata.bind} = iif(    isNull(tcbgrow_schoolid),    toString(null()),    concat(\"/tcbgrow_schools(tcbgrow_appid=\", toString(tcbgrow_schoolid), \")\"))) ~> derivedColumn1",
				"source1 select(mapColumn(",
				"          tcbgrow_appid,",
				"          tcbgrow_checklistholder",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 parse(parsed_data = tcbgrow_checklistholder ? (business_plan as boolean,",
				"          disciplinary_policy as boolean,",
				"          lease_agreement as boolean,",
				"          npo_certificate as boolean,",
				"          building_plan as boolean,",
				"          emergency_plan as boolean,",
				"          zoning_certificate as boolean,",
				"          constitution as boolean,",
				"          form29 as boolean,",
				"          form30 as boolean,",
				"          fire_safety as boolean,",
				"          health_clearance as boolean,",
				"          form16 as boolean,",
				"          form17 as boolean,",
				"          western_cape as boolean,",
				"          kwa_zulu_natal as boolean),",
				"     format: 'json',",
				"     documentForm: 'singleDocument') ~> parse1",
				"parse1 select(mapColumn(",
				"          tcbgrow_appid,",
				"          business_plan = parsed_data.business_plan,",
				"          disciplinary_policy = parsed_data.disciplinary_policy,",
				"          lease_agreement = parsed_data.lease_agreement,",
				"          npo_certificate = parsed_data.npo_certificate,",
				"          building_plan = parsed_data.building_plan,",
				"          emergency_plan = parsed_data.emergency_plan,",
				"          zoning_certificate = parsed_data.zoning_certificate,",
				"          constitution = parsed_data.constitution,",
				"          form29 = parsed_data.form29,",
				"          form30 = parsed_data.form30,",
				"          fire_safety = parsed_data.fire_safety,",
				"          health_clearance = parsed_data.health_clearance,",
				"          form16 = parsed_data.form16,",
				"          form17 = parsed_data.form17,",
				"          western_cape = parsed_data.western_cape,",
				"          kwa_zulu_natal = parsed_data.kwa_zulu_natal",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 unpivot(output(",
				"          checklist_item as string,",
				"          business_plan as boolean,",
				"          disciplinary_policy as boolean,",
				"          lease_agreement as boolean,",
				"          npo_certificate as boolean,",
				"          building_plan as boolean,",
				"          emergency_plan as boolean,",
				"          zoning_certificate as boolean,",
				"          constitution as boolean,",
				"          form29 as boolean,",
				"          form30 as boolean,",
				"          fire_safety as boolean,",
				"          health_clearance as boolean,",
				"          form16 as boolean,",
				"          form17 as boolean,",
				"          western_cape as boolean,",
				"          kwa_zulu_natal as boolean",
				"     ),",
				"     ungroupBy(tcbgrow_appid),",
				"     lateral: true,",
				"     ignoreNullPivots: false) ~> unpivot1",
				"unpivot1 select(mapColumn(",
				"          tcbgrow_appid,",
				"          checklist_item,",
				"          checklist_complete = business_plan",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3 filter(checklist_complete == true()) ~> filter1",
				"filter1, checklist join(checklist_item == cog_checklistname,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"select4 derive({cog_RegistrationStatus@odata.bind} = iif(    isNull(tcbgrow_appid),    toString(null()),    concat(\"/tcbgrow_registrationstatuses(tcbgrow_appid=\", toString(tcbgrow_appid), \")\")),",
				"          {cog_Checklist@odata.bind} = iif(    isNull(cog_checklist),    toString(null()),    concat(\"/cog_checklists(\", cog_checklist, \")\")),",
				"          cog_name = concat(cog_checklistname, \"-\", toString(tcbgrow_appid)) ,",
				"          cog_registrationstatusappid = tcbgrow_appid) ~> derivedColumn2",
				"join1 select(mapColumn(",
				"          tcbgrow_appid,",
				"          cog_checklist = cog_checklistid,",
				"          cog_checklistname",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"derivedColumn2 select(mapColumn(",
				"          {cog_RegistrationStatus@odata.bind},",
				"          {cog_Checklist@odata.bind},",
				"          cog_name,",
				"          cog_registrationstatusappid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select5",
				"select5 alterRow(upsertIf(true())) ~> alterRow2",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'tcbgrow_import_key',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     outputAssertFailedRows: true,",
				"     assertFailure_fileSystem: 'giraffe',",
				"     assertFailure_folderPath: 'errors',",
				"     mapColumn(",
				"          tcbgrow_amount = tcbgrow_amountid,",
				"          tcbgrow_appid,",
				"          tcbgrow_checklistholder,",
				"          tcbgrow_dsdapplicationsubmissiondate = tcbgrow_dsdapplicationsubmission,",
				"          tcbgrow_dsdgrantapproval,",
				"          tcbgrow_dsdgrantpaid,",
				"          tcbgrow_dsdstatus,",
				"          tcbgrow_effectivedate,",
				"          tcbgrow_eligibleforotherstudy,",
				"          tcbgrow_expirydate,",
				"          tcbgrow_franchisecommencementdate,",
				"          tcbgrow_nporegistered,",
				"          tcbgrow_nporegistrationdate,",
				"          tcbgrow_nporegistrationnumber,",
				"          tcbgrow_numberofchildrensregistration,",
				"          tcbgrow_othersubsidyenddate,",
				"          tcbgrow_othersubsidystartdate,",
				"          tcbgrow_schoolcapacity,",
				"          {tcbgrow_School@odata.bind}",
				"     )) ~> sink1",
				"alterRow2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'cog_importkey',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          cog_name,",
				"          cog_registrationstatusappid,",
				"          {cog_RegistrationStatus@odata.bind},",
				"          {cog_Checklist@odata.bind}",
				"     )) ~> sink2"
			]
		}
	}
}