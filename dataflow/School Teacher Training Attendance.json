{
	"name": "School Teacher Training Attendance",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "p_schoolteachertrainingattendance_d",
						"type": "DatasetReference"
					},
					"name": "parquetsource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DataverseSchoolTeacherTrainingAttendance",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "alterRow1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> parquetsource",
				"derivedColumn1 alterRow(upsertIf(true())) ~> alterRow1",
				"parquetsource derive({cog_Region@odata.bind} = true(),",
				"          {tcbgrow_School@odata.bind} = true(),",
				"          {tcbgrow_ECDOwner@odata.bind} = true(),",
				"          tcbgrow_attended = case(  \r",
				"    1 == 1, 'true',\r",
				"    0 == 0, 'false',  \r",
				"    '')) ~> derivedColumn1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'tcbgrow_importkey_schoolownertraining',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     outputAssertFailedRows: true,",
				"     assertFailure_fileSystem: 'giraffe',",
				"     assertFailure_folderPath: 'errors',",
				"     mapColumn(",
				"          bind = {cog_Region@odata.bind},",
				"          bind = {tcbgrow_School@odata.bind},",
				"          bind = {tcbgrow_ECDOwner@odata.bind},",
				"          tcbgrow_attended",
				"     )) ~> sink1"
			]
		}
	}
}