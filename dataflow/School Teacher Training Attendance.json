{
	"name": "School Teacher Training Attendance",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "p_schoolteachertrainingattendance_d",
						"type": "DatasetReference"
					},
					"name": "parquetsource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DataverseSchoolTeacherTrainingAttendance",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "alterRow1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          tcbgrow_attendancedate as timestamp,",
				"          tcbgrow_attendancedatestring as string,",
				"          tcbgrow_attended as integer,",
				"          tcbgrow_course as string,",
				"          tcbgrow_dateemployed as timestamp,",
				"          tcbgrow_position as string,",
				"          tcbgrow_region as long,",
				"          tcbgrow_schoolid as long,",
				"          tcbgrow_staffid as string,",
				"          tcbgrow_staffname as string,",
				"          tcbgrow_teacher as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> parquetsource",
				"derivedColumn1 alterRow(upsertIf(true())) ~> alterRow1",
				"parquetsource derive({cog_Region@odata.bind} = iif(    isNull(tcbgrow_region),    toString(null()),    concat(\"/tcbgrow_regionses(cog_appid=\", toString(tcbgrow_region), \")\")),",
				"          {tcbgrow_School@odata.bind} = iif(    isNull(tcbgrow_schoolid),    toString(null()),    concat(\"/tcbgrow_schools(tcbgrow_appid=\", toString(tcbgrow_staffid), \")\")),",
				"          {tcbgrow_Teacher@odata.bind} = iif(    isNull(tcbgrow_teacher),    toString(null()),    concat(\"/contacts(tcbgrow_appid=\", toString(tcbgrow_teacher), \")\")),",
				"          tcbgrow_attended = case(      tcbgrow_attended == 1, 'true',    tcbgrow_attended == 0, 'false',      '')) ~> derivedColumn1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'tcbgrow_importkey_schoolownertraining',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     outputAssertFailedRows: true,",
				"     assertFailure_fileSystem: 'giraffe',",
				"     assertFailure_folderPath: 'errors',",
				"     mapColumn(",
				"          bind = {cog_Region@odata.bind},",
				"          bind = {tcbgrow_School@odata.bind},",
				"          bind = {tcbgrow_ECDOwner@odata.bind},",
				"          tcbgrow_attended = {tcbgrow_Teacher@odata.bind}",
				"     )) ~> sink1"
			]
		}
	}
}