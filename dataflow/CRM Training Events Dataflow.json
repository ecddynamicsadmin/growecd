{
	"name": "CRM Training Events Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet_Training_Events",
						"type": "DatasetReference"
					},
					"name": "ParquetTrainingEvents"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "CRM_Training_Events",
						"type": "DatasetReference"
					},
					"name": "SinkTrainingEvents"
				}
			],
			"transformations": [
				{
					"name": "Upsert"
				},
				{
					"name": "DerivedColumns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cog_name as string,",
				"          cog_eventdate as timestamp,",
				"          cog_giraffeid as long,",
				"          cog_eventmasterid as integer,",
				"          cog_giraffeupdatedon as timestamp,",
				"          overriddencreatedon as timestamp,",
				"          cog_facilitator as string,",
				"          cog_venue as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> ParquetTrainingEvents",
				"DerivedColumns alterRow(upsertIf(true())) ~> Upsert",
				"ParquetTrainingEvents derive({cog_EventMasterId@odata.bind} = iif(\r",
				"    isNull(cog_eventmasterid),\r",
				"    toString(null()),\r",
				"    concat(\"/cog_trainingeventmasters(cog_giraffeid=\",toString(cog_eventmasterid),\")\")\r",
				")) ~> DerivedColumns",
				"Upsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'cog_giraffeid',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     mapColumn(",
				"          cog_name,",
				"          cog_eventdate,",
				"          cog_giraffeid,",
				"          cog_giraffeupdatedon,",
				"          overriddencreatedon,",
				"          cog_facilitator,",
				"          cog_venue,",
				"          {cog_EventMasterId@odata.bind}",
				"     )) ~> SinkTrainingEvents"
			]
		}
	}
}