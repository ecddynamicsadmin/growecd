{
	"name": "Schools Staff",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "p_schoolstaff_d",
						"type": "DatasetReference"
					},
					"name": "parquetsource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DataverseSchoolOwners",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "alterRow1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          tcbgrow_alternativenumber as string,",
				"          cog_city as long,",
				"          mobilephone as string,",
				"          telephone1 as string,",
				"          tcbgrow_countryofbirth as long,",
				"          birthdate as timestamp,",
				"          emailaddress1 as string,",
				"          tcbgrow_employeetype as long,",
				"          firstname as string,",
				"          gendercode as string,",
				"          new_staff_id as string,",
				"          tcbgrow_idnumber as string,",
				"          employeeid as string,",
				"          tcbgrow_staffactive as integer,",
				"          tcbgrow_nextofkincontactnumber as string,",
				"          tcbgrow_nextofkinemail as string,",
				"          tcbgrow_nextofkinname as string,",
				"          tcbgrow_nextofkinrelationship as long,",
				"          lastname as string,",
				"          middlename as string,",
				"          tcbgrow_staffrole as long,",
				"          cog_region as long,",
				"          cr64f_qualificationimportid as long,",
				"          tcbgrow_race as long,",
				"          tcbgrow_schoolappid as long,",
				"          tcbgrow_schoolstaff as string,",
				"          new_start_date as timestamp,",
				"          tcbgrow_startdate as timestamp,",
				"          tcbgrow_address1 as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> parquetsource",
				"derivedColumn1 alterRow(upsertIf(true())) ~> alterRow1",
				"parquetsource derive({tcbgrow_City@odata.bind} = iif(\r",
				"    isNull(cog_city),\r",
				"    toString(null()),\r",
				"    concat('/tcbgrow_cities(tcbgrow_appid=', toString(cog_city), ')')\r",
				"),",
				"          {tcbgrow_CountryofBirth@odata.bind} = iif(\r",
				"    isNull(tcbgrow_countryofbirth),\r",
				"    toString(null()),\r",
				"    concat(\"/tcbgrow_countries(tcbgrow_appid=\", toString(tcbgrow_countryofbirth), \")\")\r",
				"),",
				"          {cog_Region@odata.bind} = iif(\r",
				"    isNull(cog_region),\r",
				"    toString(null()),\r",
				"    concat(\"/tcbgrow_regionses(cog_appid=\", toString(cog_region), \")\")\r",
				"),",
				"          {cog_School@odata.bind} = iif(    isNull(new_staff_id),    toString(null()),    concat(\"/contacts(cog_appid=\", toString(new_staff_id), \")\"))) ~> derivedColumn1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'tcbgrow_import_ecdownerappid',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     outputAssertFailedRows: true,",
				"     assertFailure_fileSystem: 'giraffe',",
				"     assertFailure_folderPath: 'errors',",
				"     mapColumn(",
				"          tcbgrow_appid,",
				"          tcbgrow_address,",
				"          tcbgrow_alternativenumber,",
				"          tcbgrow_lastappdate,",
				"          tcbgrow_contactnumber,",
				"          tcbgrow_dateofbirth,",
				"          tcbgrow_emailaddress,",
				"          tcbgrow_firstname,",
				"          tcbgrow_lastname,",
				"          tcbgrow_name,",
				"          tcbgrow_preferredname,",
				"          tcbgrow_race,",
				"          {cog_Region@odata.bind},",
				"          {tcbgrow_City@odata.bind},",
				"          {tcbgrow_CountryofBirth@odata.bind}",
				"     )) ~> sink1"
			]
		}
	}
}