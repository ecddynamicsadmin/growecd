{
	"name": "Schools Staff",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "p_schoolstaff_d",
						"type": "DatasetReference"
					},
					"name": "parquetsource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DataverseSchoolStaff",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "alterRow1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          tcbgrow_alternativenumber as string,",
				"          cog_city as long,",
				"          mobilephone as string,",
				"          telephone1 as string,",
				"          tcbgrow_countryofbirth as long,",
				"          birthdate as timestamp,",
				"          emailaddress1 as string,",
				"          tcbgrow_employeetype as long,",
				"          firstname as string,",
				"          gendercode as string,",
				"          new_staff_id as string,",
				"          tcbgrow_idnumber as string,",
				"          statecode as integer,",
				"          tcbgrow_nextofkincontactnumber as string,",
				"          tcbgrow_nextofkinemail as string,",
				"          tcbgrow_nextofkinname as string,",
				"          tcbgrow_nextofkinrelationship as long,",
				"          lastname as string,",
				"          middlename as string,",
				"          tcbgrow_staffrole as long,",
				"          cog_region as long,",
				"          tcbgrow_qualification as long,",
				"          tcbgrow_race as long,",
				"          tcbgrow_schoolappid as long,",
				"          tcbgrow_schoolstaff as string,",
				"          new_start_date as timestamp,",
				"          tcbgrow_startdate as timestamp,",
				"          tcbgrow_address1 as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> parquetsource",
				"derivedColumn1 alterRow(upsertIf(true())) ~> alterRow1",
				"filter1 derive({cog_City@odata.bind} = iif(\r",
				"    isNull(cog_city),\r",
				"    toString(null()),\r",
				"    concat('/tcbgrow_cities(tcbgrow_appid=', toString(cog_city), ')')\r",
				"),",
				"          {tcbgrow_CountryofBirth@odata.bind} = iif(\r",
				"    isNull(tcbgrow_countryofbirth),\r",
				"    toString(null()),\r",
				"    concat(\"/tcbgrow_countries(tcbgrow_appid=\", toString(tcbgrow_countryofbirth), \")\")\r",
				"),",
				"          {cog_Region@odata.bind} = iif(    isNull(cog_region),    toString(null()),    concat(\"/tcbgrow_regionses(cog_appid=\", toString(cog_region), \")\")),",
				"          {tcbgrow_School@odata.bind} = iif(    isNull(new_staff_id),    toString(null()),    concat(\"/contacts(cog_appid=\", toString(new_staff_id), \")\")),",
				"          {tcbgrow_Qualification@odata.bind} = iif(    isNull(tcbgrow_qualification),    toString(null()),    concat(\"/tcbgrow_qualifications(cog_appid=\", toString(tcbgrow_qualification), \")\")),",
				"          birthdate = toString(birthdate, 'yyyy-MM-dd') ) ~> derivedColumn1",
				"parquetsource filter(tcbgrow_schoolappid==10803) ~> filter1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'tcbgrow_school_staff_key',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     outputAssertFailedRows: true,",
				"     assertFailure_fileSystem: 'giraffe',",
				"     assertFailure_folderPath: 'errors',",
				"     mapColumn(",
				"          tcbgrow_alternativenumber,",
				"          mobilephone,",
				"          telephone1,",
				"          birthdate,",
				"          emailaddress1,",
				"          tcbgrow_employeetype,",
				"          firstname,",
				"          gendercode,",
				"          new_staff_id,",
				"          tcbgrow_idnumber,",
				"          statecode,",
				"          tcbgrow_nextofkincontactnumber,",
				"          tcbgrow_nextofkinemail,",
				"          tcbgrow_nextofkinname,",
				"          tcbgrow_nextofkinrelationship,",
				"          lastname,",
				"          middlename,",
				"          tcbgrow_staffrole = {tcbgrow_Qualification@odata.bind},",
				"          tcbgrow_race,",
				"          tcbgrow_schoolappid,",
				"          tcbgrow_schoolstaff,",
				"          new_start_date,",
				"          tcbgrow_startdate,",
				"          tcbgrow_address1,",
				"          {tcbgrow_School@odata.bind},",
				"          {cog_Region@odata.bind},",
				"          {tcbgrow_City@odata.bind} = {cog_City@odata.bind},",
				"          {tcbgrow_CountryofBirth@odata.bind}",
				"     )) ~> sink1"
			]
		}
	}
}