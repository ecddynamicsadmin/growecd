{
	"name": "Schools Age Group",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "p_schoolagegroup_d",
						"type": "DatasetReference"
					},
					"name": "parquetsource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DataverseSchoolAgeGroup",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "alterRow1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     LastRunDate as string (\"2026-03-03\")",
				"}",
				"source(output(",
				"          id as long,",
				"          age_group_id as long,",
				"          fees as long,",
				"          renewed_effective_fees as long,",
				"          renewed_effective_date as timestamp,",
				"          school_id as long,",
				"          created_by as integer,",
				"          updated_by as integer,",
				"          created_at as timestamp,",
				"          updated_at as timestamp,",
				"          late_early_fee as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> parquetsource",
				"derivedColumn1 alterRow(upsertIf(true())) ~> alterRow1",
				"parquetsource derive({tcbgrow_School@odata.bind} = iif(    isNull(tcbgrow_school),    toString(null()),    concat(\"/tcbgrow_schools(tcbgrow_appid=\", toString(tcbgrow_school), \")\"))) ~> derivedColumn1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'tcbgrow_import_key',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     outputAssertFailedRows: true,",
				"     assertFailure_fileSystem: 'giraffe',",
				"     assertFailure_folderPath: 'errors',",
				"     mapColumn(",
				"          tcbgrow_appid,",
				"          {tcbgrow_AgeGroup@odata.bind},",
				"          {tcbgrow_School@odata.bind},",
				"          {cog_Region@odata.bind},",
				"          {tcbgrow_Country@odata.bind},",
				"          {tcbgrow_City@odata.bind},",
				"          tcbgrow_firstname,",
				"          tcbgrow_lastname,",
				"          tcbgrow_middlename,",
				"          tcbgrow_dateofbirth,",
				"          tcbgrow_startdate,",
				"          tcbgrow_enrolldate,",
				"          tcbgrow_gender,",
				"          tcbgrow_temporary,",
				"          tcbgrow_leaneractive,",
				"          tcbgrow_leanerspecial,",
				"          tcbgrow_learnergraduated,",
				"          tcbgrow_race,",
				"          tcbgrow_idnumber,",
				"          tcbgrow_leanerage,",
				"          tcbgrow_name,",
				"          tcbgrow_address",
				"     )) ~> sink1"
			]
		}
	}
}