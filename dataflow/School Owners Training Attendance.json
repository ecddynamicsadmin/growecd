{
	"name": "School Owners Training Attendance",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "p_schoolownertrainingattendance_d",
						"type": "DatasetReference"
					},
					"name": "parquetsource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DataverseSchoolOwnersTrainingAttendance",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "alterRow1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "schoolidisnotnull"
				}
			],
			"scriptLines": [
				"source(output(",
				"          tcbgrow_attended as integer,",
				"          tcbgrow_coursetype as string,",
				"          tcbgrow_ecdowner as long,",
				"          tcbgrow_franchiseenumber as long,",
				"          tcbgrow_groupname as string,",
				"          tcbgrow_grouptrain as string,",
				"          tcbgrow_meeting as string,",
				"          tcbgrow_meetingdate as timestamp,",
				"          tcbgrow_mentor as string,",
				"          tcbgrow_ownername as string,",
				"          tcbgrow_region as long,",
				"          tcbgrow_schoolid as long,",
				"          tcbgrow_meetingdatestring as string,",
				"          tcbgrow_ownerid as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> parquetsource",
				"derivedColumn1 alterRow(upsertIf(true())) ~> alterRow1",
				"schoolidisnotnull derive({cog_Region@odata.bind} = iif(    isNull(tcbgrow_region),    toString(null()),    concat(\"/tcbgrow_regionses(cog_appid=\", toString(tcbgrow_region), \")\")),",
				"          {tcbgrow_School@odata.bind} = iif(    isNull(tcbgrow_schoolid),    toString(null()),    concat(\"/tcbgrow_schools(tcbgrow_appid=\", toString(tcbgrow_schoolid), \")\")),",
				"          {tcbgrow_ECDOwner@odata.bind} = iif(    isNull(tcbgrow_ecdowner),    toString(null()),    concat(\"/tcbgrow_ecdowners(tcbgrow_appid=\", toString(tcbgrow_ecdowner), \")\")),",
				"          tcbgrow_attended = case(  \r",
				"    tcbgrow_attended == 1, 'true',\r",
				"    tcbgrow_attended == 0, 'false',  \r",
				"    '')) ~> derivedColumn1",
				"parquetsource filter(not(isNull(tcbgrow_schoolid))) ~> schoolidisnotnull",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'tcbgrow_importkey_schoolownertraining',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     outputAssertFailedRows: true,",
				"     assertFailure_fileSystem: 'giraffe',",
				"     assertFailure_folderPath: 'errors',",
				"     mapColumn(",
				"          tcbgrow_attended,",
				"          tcbgrow_coursetype,",
				"          tcbgrow_franchiseenumber,",
				"          tcbgrow_groupname,",
				"          tcbgrow_grouptrain,",
				"          tcbgrow_meeting,",
				"          tcbgrow_meetingdate,",
				"          tcbgrow_mentor,",
				"          tcbgrow_ownername,",
				"          {tcbgrow_School@odata.bind},",
				"          {tcbgrow_ECDOwner@odata.bind},",
				"          {cog_Region@odata.bind},",
				"          tcbgrow_meetingdatestring,",
				"          tcbgrow_ownerid,",
				"          tcbgrow_schoolid",
				"     )) ~> sink1"
			]
		}
	}
}