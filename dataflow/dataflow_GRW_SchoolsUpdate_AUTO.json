{
	"name": "dataflow_GRW_SchoolsUpdate_AUTO",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "parquet_schoolsupdate_destination",
						"type": "DatasetReference"
					},
					"name": "schoolupdateparquet"
				}
			],
			"sinks": [
				{
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as long,",
				"          school_id as string,",
				"          franchisee_id as long,",
				"          region_id as long,",
				"          city_id as long,",
				"          province_id as long,",
				"          grow_id as string,",
				"          name as string,",
				"          learner_capacity as string,",
				"          number_of_classrooms as string,",
				"          logo as string,",
				"          address as string,",
				"          school_commencement_date as timestamp,",
				"          break_even_fee as integer,",
				"          capacity as integer,",
				"          form_11 as string,",
				"          hr_email as string,",
				"          hr_staff_code as string,",
				"          ecd_start_date as timestamp,",
				"          ecd_code as string,",
				"          contract as string,",
				"          contract_start_date as timestamp,",
				"          contract_end_date as timestamp,",
				"          business_mentor_id as decimal(38,0),",
				"          education_mentor_id as decimal(38,0),",
				"          business_mentor_name as string,",
				"          business_mentor_phone_number as string,",
				"          business_mentor_email as string,",
				"          education_mentor_name as string,",
				"          education_mentor_phone_number as string,",
				"          education_mentor_email as string,",
				"          hourly_late_or_early_fee as long,",
				"          created_by as integer,",
				"          updated_by as integer,",
				"          created_at as timestamp,",
				"          updated_at as timestamp,",
				"          school_status as string,",
				"          inventory_group_id as decimal(38,0),",
				"          monthly_salaries as decimal(38,18),",
				"          is_learner_payment as boolean,",
				"          is_learner_attendance as boolean,",
				"          is_learner_assessment as boolean,",
				"          is_caregiver_access as boolean,",
				"          segment as string,",
				"          agreement_type as string,",
				"          program_status as string,",
				"          owner_id as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> schoolupdateparquet",
				"schoolupdateparquet alterRow() ~> alterRow1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}