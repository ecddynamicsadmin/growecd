{
	"name": "dataflow_GRW_SchoolsUpdate_AUTO",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "parquet_schoolsupdate",
						"type": "DatasetReference"
					},
					"name": "schoolupdateparquet"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "storage_GRW_SchoolsUpdate_AUTO_csv",
						"type": "DatasetReference"
					},
					"name": "sinktocsv"
				}
			],
			"transformations": [
				{
					"name": "removeformatting"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> schoolupdateparquet",
				"schoolupdateparquet derive(address = replace(replace(address, '\\n', ','), '\\r', ','),",
				"          school_commencement_date = toString(toTimestamp(school_commencement_date, 'yyyy-MM-dd\\'T\\'HH:mm:ss'), 'yyyy-MM-dd'),",
				"          contract_start_date = toString(toTimestamp(contract_start_date, 'yyyy-MM-dd\\'T\\'HH:mm:ss'), 'yyyy-MM-dd'),",
				"          contract_end_date = toString(toTimestamp(contract_end_date, 'yyyy-MM-dd\\'T\\'HH:mm:ss'), 'yyyy-MM-dd'),",
				"          created_at = toString(toTimestamp(created_at, 'yyyy-MM-dd\\'T\\'HH:mm:ss'), 'yyyy-MM-dd'),",
				"          updated_at = toString(toTimestamp(updated_at, 'yyyy-MM-dd\\'T\\'HH:mm:ss'), 'yyyy-MM-dd'),",
				"          ecd_start_date = toString(toTimestamp(ecd_start_date, 'yyyy-MM-dd\\'T\\'HH:mm:ss'), 'yyyy-MM-dd')) ~> removeformatting",
				"removeformatting sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['vw_schools_rpt_final_null_op.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sinktocsv"
			]
		}
	}
}