{
	"name": "CRM Training Event Master",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet_Training_Event_Master",
						"type": "DatasetReference"
					},
					"name": "ParquetTrainingEventMAster"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "CRM_Training_Event_Master",
						"type": "DatasetReference"
					},
					"name": "SinkTrainingEventMaster"
				}
			],
			"transformations": [
				{
					"name": "Upsert"
				},
				{
					"name": "DerivedColumns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          mobilephone as string,",
				"          emailaddress1 as string,",
				"          firstname as string,",
				"          lastname as string,",
				"          birthdate as timestamp,",
				"          cog_gendercode as byte,",
				"          cog_racecode as byte,",
				"          cog_raceother as string,",
				"          address1_city as string,",
				"          address1_line1 as string,",
				"          cog_countryid as string,",
				"          cog_region as string,",
				"          cog_giraffeprofileid as integer,",
				"          cog_centreid as integer,",
				"          cog_rolecode as byte,",
				"          cog_startdate as timestamp,",
				"          cog_childprotectionclearancecode as byte,",
				"          cog_employmenttypecode as byte,",
				"          cog_highestqualificationcode as byte,",
				"          cog_workhourstotal as integer,",
				"          cog_giraffeupdatedon as timestamp,",
				"          overriddencreatedon as timestamp,",
				"          cog_applicationuser as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> ParquetTrainingEventMAster",
				"DerivedColumns alterRow(upsertIf(true())) ~> Upsert",
				"ParquetTrainingEventMAster derive({cog_CountryId@odata.bind} = iif(\r",
				"    isNull(cog_countryid),\r",
				"    toString(null()),\r",
				"    concat(\"/cog_countries(cog_countrycode='\",toString(cog_countryid),\"')\")\r",
				"),",
				"          {cog_Region@odata.bind} = iif(\r",
				"    isNull(cog_region),\r",
				"    toString(null()),\r",
				"    concat(\"/cog_regions(cog_regioncode='\",toString(cog_region),\"')\")\r",
				"),",
				"          cog_programme = case(\r",
				"    isNull(cog_programme), 769070000,\r",
				"    cog_programme == true(), 769070001,\r",
				"    cog_programme == false(), 769070002\r",
				"  ),",
				"          overriddencreatedon = toString(toUTC(overriddencreatedon, 'Africa/Johannesburg'), \"yyyy-MM-dd'T'HH:mm:ss'Z'\"),",
				"          cog_centrestartdate = toString(toDate(cog_centrestartdate), 'yyyy-MM-dd'),",
				"          cog_giraffeupdatedon = toString(toUTC(cog_giraffeupdatedon, 'Africa/Johannesburg'), \"yyyy-MM-dd'T'HH:mm:ss'Z'\"),",
				"          cog_classtypecode = iif(\r",
				"  size(filter(split(regexReplace(toString(cog_classtypecode), '[\\\\[\\\\]\\\\s\"]', ''), ','), in(['1','2','3','4','5','6','7'], #item))) == 0,\r",
				"  toString(null()),\r",
				"  reduce(\r",
				"    filter(split(regexReplace(toString(cog_classtypecode), '[\\\\[\\\\]\\\\s\"]', ''), ','), in(['1','2','3','4','5','6','7'], #item)),\r",
				"    '',\r",
				"    iif(#acc == '', #item, #acc + ',' + #item),\r",
				"    #result\r",
				"  )\r",
				"),",
				"          cog_centretypecode = iif(\r",
				"  isNull(cog_centretypecode) || trim(toString(cog_centretypecode)) == '',\r",
				"  toInteger(null()),\r",
				"  iif(in(['1','2','3','4','5'], trim(toString(cog_centretypecode))),\r",
				"      toInteger(trim(toString(cog_centretypecode))),\r",
				"      6)\r",
				"),",
				"          cog_centretypeother = iif(\r",
				"  isNull(cog_centretypecode) || trim(toString(cog_centretypecode)) == '' || in(['1','2','3','4','5'], trim(toString(cog_centretypecode))),\r",
				"  toString(null()),\r",
				"  left(trim(toString(cog_centretypecode)), 255)\r",
				"),",
				"          cog_propertytypecode = iif(\r",
				"  isNull(cog_propertytypecode) || trim(toString(cog_propertytypecode)) == '',\r",
				"  toInteger(null()),\r",
				"  iif(in(['1','2','3'], trim(toString(cog_propertytypecode))),\r",
				"      toInteger(trim(toString(cog_propertytypecode))),\r",
				"      99)\r",
				"),",
				"          cog_propertytypeother = iif(\r",
				"  isNull(cog_propertytypecode) || trim(toString(cog_propertytypecode)) == '' || in(['1','2','3'], trim(toString(cog_propertytypecode))),\r",
				"  toString(null()),\r",
				"  left(trim(toString(cog_propertytypecode)), 255)\r",
				")) ~> DerivedColumns",
				"Upsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'cog_centreid',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     mapColumn(",
				"          cog_centreid,",
				"          name,",
				"          address1_city,",
				"          address1_line1,",
				"          emailaddress1,",
				"          telephone1,",
				"          cog_centrestartdate,",
				"          cog_learnercapacity,",
				"          cog_classroomcount,",
				"          cog_ecdtypecode,",
				"          cog_agreementtypecode,",
				"          cog_giraffeupdatedon,",
				"          overriddencreatedon,",
				"          cog_programme,",
				"          cog_programmestatuscode,",
				"          cog_propertytypecode,",
				"          cog_centretypecode,",
				"          cog_classtypecode,",
				"          cog_operatinghours,",
				"          {cog_CountryId@odata.bind},",
				"          {cog_Region@odata.bind},",
				"          cog_centretypeother,",
				"          cog_propertytypeother",
				"     )) ~> SinkTrainingEventMaster"
			]
		}
	}
}