{
	"name": "Staff Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "p_schoolstaff_d",
						"type": "DatasetReference"
					},
					"name": "parquetsource"
				},
				{
					"dataset": {
						"referenceName": "DataverseSchool",
						"type": "DatasetReference"
					},
					"name": "dataverseschools"
				},
				{
					"dataset": {
						"referenceName": "p_schoolstaff_d",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DataverseSchoolStaff",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					}
				},
				{
					"dataset": {
						"referenceName": "DataverseSchool",
						"type": "DatasetReference"
					},
					"name": "sink2"
				},
				{
					"dataset": {
						"referenceName": "p_schoolstaff_d_inactive",
						"type": "DatasetReference"
					},
					"name": "staffinactiveparquet"
				}
			],
			"transformations": [
				{
					"name": "alterRow1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "joinschoolappis"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "alterRow2"
				},
				{
					"name": "select1"
				},
				{
					"name": "staffroleprinciple"
				},
				{
					"name": "inactiveonly"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          tcbgrow_alternativenumber as string,",
				"          cog_city as long,",
				"          mobilephone as string,",
				"          telephone1 as string,",
				"          tcbgrow_countryofbirth as long,",
				"          birthdate as timestamp,",
				"          emailaddress1 as string,",
				"          tcbgrow_employeetype as long,",
				"          firstname as string,",
				"          gendercode as string,",
				"          new_staff_id as string,",
				"          tcbgrow_idnumber as string,",
				"          updated_at as timestamp,",
				"          statecode as integer,",
				"          tcbgrow_nextofkincontactnumber as string,",
				"          tcbgrow_nextofkinemail as string,",
				"          tcbgrow_nextofkinname as string,",
				"          tcbgrow_nextofkinrelationship as long,",
				"          lastname as string,",
				"          middlename as string,",
				"          tcbgrow_staffrole as long,",
				"          cog_region as long,",
				"          tcbgrow_qualification as long,",
				"          tcbgrow_race as long,",
				"          tcbgrow_schoolappid as long,",
				"          tcbgrow_schoolstaff as string,",
				"          new_start_date as timestamp,",
				"          tcbgrow_startdate as timestamp,",
				"          tcbgrow_address1 as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> parquetsource",
				"source(output(",
				"          {@odata.etag} as string,",
				"          tcbgrow_appid as string,",
				"          tcbgrow_name as string,",
				"          tcbgrow_schoolid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     query: '<fetch>\\n  <entity name=\"tcbgrow_school\">\\n    <attribute name=\"tcbgrow_appid\" />\\n    <attribute name=\"tcbgrow_name\" />\\n    <attribute name=\"tcbgrow_schoolid\" />\\n  </entity>\\n</fetch>') ~> dataverseschools",
				"source(output(",
				"          tcbgrow_alternativenumber as string,",
				"          cog_city as long,",
				"          mobilephone as string,",
				"          telephone1 as string,",
				"          tcbgrow_countryofbirth as long,",
				"          birthdate as timestamp,",
				"          emailaddress1 as string,",
				"          tcbgrow_employeetype as long,",
				"          firstname as string,",
				"          gendercode as string,",
				"          new_staff_id as string,",
				"          tcbgrow_idnumber as string,",
				"          updated_at as timestamp,",
				"          statecode as integer,",
				"          tcbgrow_nextofkincontactnumber as string,",
				"          tcbgrow_nextofkinemail as string,",
				"          tcbgrow_nextofkinname as string,",
				"          tcbgrow_nextofkinrelationship as long,",
				"          lastname as string,",
				"          middlename as string,",
				"          tcbgrow_staffrole as long,",
				"          cog_region as long,",
				"          tcbgrow_qualification as long,",
				"          tcbgrow_race as long,",
				"          tcbgrow_schoolappid as long,",
				"          tcbgrow_schoolstaff as string,",
				"          new_start_date as timestamp,",
				"          tcbgrow_startdate as timestamp,",
				"          tcbgrow_address1 as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> source1",
				"derivedColumn1 alterRow(upsertIf(true())) ~> alterRow1",
				"parquetsource derive({cog_City@odata.bind} = iif(\r",
				"    isNull(cog_city),\r",
				"    toString(null()),\r",
				"    concat('/tcbgrow_cities(tcbgrow_appid=', toString(cog_city), ')')\r",
				"),",
				"          {tcbgrow_CountryOfBirth@odata.bind} = iif(\r",
				"    isNull(tcbgrow_countryofbirth),\r",
				"    toString(null()),\r",
				"    concat(\"/tcbgrow_countries(tcbgrow_appid=\", toString(tcbgrow_countryofbirth), \")\")\r",
				"),",
				"          {cog_Region@odata.bind} = iif(    isNull(cog_region),    toString(null()),    concat(\"/tcbgrow_regionses(cog_appid=\", toString(cog_region), \")\")),",
				"          {tcbgrow_School@odata.bind} = iif(    isNull(tcbgrow_schoolappid),    toString(null()),    concat(\"/tcbgrow_schools(tcbgrow_appid=\", toString(tcbgrow_schoolappid), \")\")),",
				"          {tcbgrow_Qualification@odata.bind} = iif(    isNull(tcbgrow_qualification),    toString(null()),    concat(\"/tcbgrow_qualifications(tcbgrow_appid=\", toString(tcbgrow_qualification), \")\")),",
				"          birthdate = toString(birthdate, 'yyyy-MM-dd'),",
				"          gendercode = case(\r",
				"    trim(gendercode) == 'Male', 1,\r",
				"    trim(gendercode) == 'Female', 2,\r",
				"    trim(gendercode) == 'TBC', 3,\r",
				"    toInteger(null())\r",
				"    ),",
				"          statecode = case(\r",
				"     statecode == 0, 1,\r",
				"     statecode == 1, 0,\r",
				"     toInteger(null())\r",
				")) ~> derivedColumn1",
				"staffroleprinciple, dataverseschools join(tcbgrow_schoolappid == toInteger(tcbgrow_appid),",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinschoolappis",
				"select1 derive({tcbgrow_SchoolPrinciple@odata.bind} = iif(isNull(new_staff_id),toString(null()),concat(\"/contacts(new_staff_id='\", trim(new_staff_id), \"')\"))) ~> derivedColumn2",
				"derivedColumn2 alterRow(updateIf(true())) ~> alterRow2",
				"joinschoolappis select(mapColumn(",
				"          tcbgrow_appid,",
				"          tcbgrow_schoolid,",
				"          new_staff_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"parquetsource filter(tcbgrow_staffrole==1) ~> staffroleprinciple",
				"source1 filter(statecode==0) ~> inactiveonly",
				"inactiveonly select(mapColumn(",
				"          new_staff_id,",
				"          lastname",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'tcbgrow_school_staff_key',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     outputAssertFailedRows: true,",
				"     assertFailure_fileSystem: 'giraffe',",
				"     assertFailure_folderPath: 'errors',",
				"     mapColumn(",
				"          tcbgrow_alternativenumber,",
				"          mobilephone,",
				"          telephone1,",
				"          birthdate,",
				"          emailaddress1,",
				"          tcbgrow_employeetype,",
				"          firstname,",
				"          gendercode,",
				"          new_staff_id,",
				"          tcbgrow_idnumber,",
				"          tcbgrow_nextofkincontactnumber,",
				"          tcbgrow_nextofkinemail,",
				"          tcbgrow_nextofkinname,",
				"          tcbgrow_nextofkinrelationship,",
				"          lastname,",
				"          middlename,",
				"          tcbgrow_race,",
				"          tcbgrow_schoolstaff,",
				"          new_start_date,",
				"          tcbgrow_startdate,",
				"          tcbgrow_address1,",
				"          {cog_Region@odata.bind},",
				"          {cog_City@odata.bind},",
				"          {tcbgrow_Qualification@odata.bind},",
				"          {tcbgrow_CountryOfBirth@odata.bind},",
				"          {tcbgrow_School@odata.bind}",
				"     )) ~> sink1",
				"alterRow2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:true,",
				"     upsertable:false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 2,",
				"     mapColumn(",
				"          {tcbgrow_SchoolPrinciple@odata.bind},",
				"          tcbgrow_schoolid",
				"     )) ~> sink2",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          tcbgrow_alternativenumber as string,",
				"          cog_city as long,",
				"          mobilephone as string,",
				"          telephone1 as string,",
				"          tcbgrow_countryofbirth as long,",
				"          birthdate as timestamp,",
				"          emailaddress1 as string,",
				"          tcbgrow_employeetype as long,",
				"          firstname as string,",
				"          gendercode as string,",
				"          new_staff_id as string,",
				"          tcbgrow_idnumber as string,",
				"          updated_at as timestamp,",
				"          statecode as integer,",
				"          tcbgrow_nextofkincontactnumber as string,",
				"          tcbgrow_nextofkinemail as string,",
				"          tcbgrow_nextofkinname as string,",
				"          tcbgrow_nextofkinrelationship as long,",
				"          lastname as string,",
				"          middlename as string,",
				"          tcbgrow_staffrole as long,",
				"          cog_region as long,",
				"          tcbgrow_qualification as long,",
				"          tcbgrow_race as long,",
				"          tcbgrow_schoolappid as long,",
				"          tcbgrow_schoolstaff as string,",
				"          new_start_date as timestamp,",
				"          tcbgrow_startdate as timestamp,",
				"          tcbgrow_address1 as string",
				"     ),",
				"     format: 'parquet',",
				"     partitionFileNames:['p_schoolstaff_d_inactive.parquet'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 3,",
				"     partitionBy('hash', 1)) ~> staffinactiveparquet"
			]
		}
	}
}