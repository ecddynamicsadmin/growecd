{
	"name": "Schools Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "p_schools_d",
						"type": "DatasetReference"
					},
					"name": "parquetsource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DataverseSchool",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "alterRow1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          tcbgrow_breakeven as integer,",
				"          tcbgrow_ecdowner as long,",
				"          tcbgrow_paymenttype as string,",
				"          tcbgrow_schoolsegment as string,",
				"          tcbgrow_monthlysalaries as decimal(38,9),",
				"          tcbgrow_schoolstatus as string,",
				"          updated_at as timestamp,",
				"          tcbgrow_contractdate as timestamp,",
				"          tcbgrow_ecdcode as string,",
				"          tcbgrow_commencementdate as timestamp,",
				"          tcbgrow_address as string,",
				"          tcbgrow_numberofclassrooms as string,",
				"          tcbgrow_name as string,",
				"          cog_city as long,",
				"          cog_region as long,",
				"          tcbgrow_growid as string,",
				"          tcbgrow_appid as long,",
				"          tcbgrow_capacity as integer,",
				"          tcbgrow_country as integer,",
				"          tcbgrow_appaccountcreationdate as timestamp,",
				"          tcbgrow_centrestartdate as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> parquetsource",
				"derivedColumn1 alterRow(upsertIf(true())) ~> alterRow1",
				"parquetsource derive(tcbgrow_paymenttypechoice = case(  \r",
				"    trim(tcbgrow_paymenttype) == 'Loan Only', 301220005,  \r",
				"    trim(tcbgrow_paymenttype) == 'Cash Only', 301220000,  \r",
				"    trim(tcbgrow_paymenttype) == 'Grant Only', 301220011,  \r",
				"    trim(tcbgrow_paymenttype) == 'Partner Funded', 301220006,  \r",
				"    trim(tcbgrow_paymenttype) == 'Loan/Cash', 301220002,  \r",
				"    trim(tcbgrow_paymenttype) == 'Grant/Cash', 301220001,  \r",
				"    trim(tcbgrow_paymenttype) == 'Loan/Grant/Cash', 301220003,  \r",
				"    trim(tcbgrow_paymenttype) == 'Grant/Partner Funded', 301220007,  \r",
				"    trim(tcbgrow_paymenttype) == 'Loan/Grant/Partner Funded', 301220008,  \r",
				"    trim(tcbgrow_paymenttype) == 'Cash/Grant/Partner Funded', 301220009,  \r",
				"    trim(tcbgrow_paymenttype) == 'Cash/Loan/Grant/Partner Funded', 301220010,  \r",
				"    trim(tcbgrow_paymenttype) == 'Loan/Partner Funded', 301220012,  \r",
				"    trim(tcbgrow_paymenttype) == 'Cash/Partner Funded', 523930001,  \r",
				"    trim(tcbgrow_paymenttype) == 'None', 301220013,  \r",
				"    trim(tcbgrow_paymenttype) == 'Former Partner Centre', 301220014,  \r",
				"    toInteger(null())  \r",
				"),",
				"          {cog_City@odata.bind} = iif(\r",
				"    isNull(cog_city),\r",
				"    toString(null()),\r",
				"    concat(\"/tcbgrow_cities(tcbgrow_appid=\",toString(cog_city),\")\")\r",
				"),",
				"          {tcbgrow_Country@odata.bind} = iif(\r",
				"    isNull(tcbgrow_country),\r",
				"    toString(null()),\r",
				"    concat(\"/tcbgrow_countries(tcbgrow_appid=\", toString(tcbgrow_country), \")\")\r",
				"),",
				"          {tcbgrow_ECDOwner@odata.bind} = iif(\r",
				"    isNull(tcbgrow_ecdowner),\r",
				"    toString(null()),\r",
				"    concat(\"/tcbgrow_ecdowners(tcbgrow_appid=\", toString(tcbgrow_ecdowner), \")\")\r",
				"),",
				"          {cog_Region@odata.bind} = iif(\r",
				"    isNull(cog_region),\r",
				"    toString(null()),\r",
				"    concat(\"/tcbgrow_regionses(cog_appid=\", toString(cog_region), \")\")\r",
				"),",
				"          {tcbgrow_SchoolSegment@odata.bind} = iif(\r",
				"    isNull(tcbgrow_schoolsegment),\r",
				"    toString(null()),\r",
				"    concat(\"/tcbgrow_customersegments(tcbgrow_appid=\", toString(tcbgrow_schoolsegment), \")\")\r",
				"),",
				"          tcbgrow_numberofclassrooms = toInteger(tcbgrow_numberofclassrooms)) ~> derivedColumn1",
				"alterRow1 sort(asc(tcbgrow_appid, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'tcbgrow_import_key',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     outputAssertFailedRows: true,",
				"     assertFailure_fileSystem: 'giraffe',",
				"     assertFailure_folderPath: 'errors',",
				"     mapColumn(",
				"          tcbgrow_breakeven,",
				"          tcbgrow_paymenttype = tcbgrow_paymenttypechoice,",
				"          tcbgrow_monthlysalaries,",
				"          tcbgrow_schoolstatus,",
				"          tcbgrow_contractdate,",
				"          tcbgrow_commencementdate,",
				"          tcbgrow_address,",
				"          tcbgrow_numberofclassrooms,",
				"          tcbgrow_name,",
				"          tcbgrow_growid,",
				"          tcbgrow_appid,",
				"          tcbgrow_capacity,",
				"          tcbgrow_appaccountcreationdate,",
				"          tcbgrow_centrestartdate,",
				"          {cog_City@odata.bind},",
				"          {tcbgrow_Country@odata.bind},",
				"          {tcbgrow_ECDOwner@odata.bind},",
				"          {tcbgrow_SchoolSegment@odata.bind},",
				"          {cog_Region@odata.bind}",
				"     )) ~> sink1"
			]
		}
	}
}