{
	"name": "Staff Inactive",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "p_schoolstaff_d_inactive",
						"type": "DatasetReference"
					},
					"name": "inactive"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Contacts",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     EnvironmentURL as string (\"https://growecddev.crm4.dynamics.com\")",
				"}",
				"source(output(",
				"          tcbgrow_alternativenumber as string,",
				"          cog_city as long,",
				"          mobilephone as string,",
				"          telephone1 as string,",
				"          tcbgrow_countryofbirth as long,",
				"          birthdate as timestamp,",
				"          emailaddress1 as string,",
				"          tcbgrow_employeetype as long,",
				"          firstname as string,",
				"          gendercode as string,",
				"          new_staff_id as string,",
				"          tcbgrow_idnumber as string,",
				"          updated_at as timestamp,",
				"          statecode as integer,",
				"          tcbgrow_nextofkincontactnumber as string,",
				"          tcbgrow_nextofkinemail as string,",
				"          tcbgrow_nextofkinname as string,",
				"          tcbgrow_nextofkinrelationship as long,",
				"          lastname as string,",
				"          middlename as string,",
				"          tcbgrow_staffrole as long,",
				"          cog_region as long,",
				"          tcbgrow_qualification as long,",
				"          tcbgrow_race as long,",
				"          tcbgrow_schoolappid as long,",
				"          tcbgrow_schoolstaff as string,",
				"          new_start_date as timestamp,",
				"          tcbgrow_startdate as timestamp,",
				"          tcbgrow_address1 as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> inactive",
				"inactive derive(restUrl = concat(\"contacts(new_staff_id='\", new_staff_id, \"')\"),",
				"          statecode = 1,",
				"          statuscode = 2) ~> derivedColumn1",
				"derivedColumn1 alterRow(updateIf(true())) ~> alterRow1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:true,",
				"     insertable:true,",
				"     updateable:true,",
				"     upsertable:true,",
				"     rowRelativeUrl: 'restUrl',",
				"     insertHttpMethod: 'PATCH',",
				"     deleteHttpMethod: 'DELETE',",
				"     upsertHttpMethod: 'PUT',",
				"     updateHttpMethod: 'PATCH',",
				"     timeout: 30,",
				"     batchSize: 1,",
				"     headers: ['Content-Type' -> 'application/json', 'OData-MaxVersion' -> '4.0', 'OData-Version' -> '4.0', 'If-Match' -> '*'],",
				"     requestFormat: ['type' -> 'json'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          statecode,",
				"          statuscode",
				"     ),",
				"     partitionBy('roundRobin', 16)) ~> sink1"
			]
		}
	}
}