{
	"name": "Schools Owners",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "p_schoolowners_d",
						"type": "DatasetReference"
					},
					"name": "parquetsource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DataverseSchoolOwners",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "alterRow1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          tcbgrow_appid as long,",
				"          tcbgrow_address as string,",
				"          tcbgrow_alternativenumber as string,",
				"          tcbgrow_city as long,",
				"          tcbgrow_lastappdate as timestamp,",
				"          created_at as timestamp,",
				"          tcbgrow_contactnumber as string,",
				"          tcbgrow_countryofbirth as long,",
				"          tcbgrow_dateofbirth as timestamp,",
				"          tcbgrow_emailaddress as string,",
				"          tcbgrow_firstname as string,",
				"          tcbgrow_lastname as string,",
				"          tcbgrow_name as string,",
				"          tcbgrow_preferredname as string,",
				"          tcbgrow_race as long,",
				"          cog_region as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> parquetsource",
				"derivedColumn1 alterRow(upsertIf(true())) ~> alterRow1",
				"parquetsource derive({cog_City@odata.bind} = concat(\"/tcbgrow_cities(tcbgrow_appid=\",toString(tcbgrow_city),\")\"),",
				"          {tcbgrow_CountryofBirth@odata.bind} = concat(\"/tcbgrow_countries(tcbgrow_appid=\", toString(tcbgrow_countryofbirth), \")\"),",
				"          {cog_Region@odata.bind} = concat(\"/tcbgrow_regionses(tcbgrow_appid=\", toString(cog_region), \")\")) ~> derivedColumn1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'tcbgrow_import_ecdownerappid',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     outputAssertFailedRows: true,",
				"     assertFailure_fileSystem: 'giraffe',",
				"     assertFailure_folderPath: 'errors',",
				"     mapColumn(",
				"          tcbgrow_appid,",
				"          tcbgrow_address,",
				"          tcbgrow_alternativenumber,",
				"          tcbgrow_lastappdate,",
				"          tcbgrow_contactnumber,",
				"          tcbgrow_dateofbirth,",
				"          tcbgrow_emailaddress,",
				"          tcbgrow_firstname,",
				"          tcbgrow_lastname,",
				"          tcbgrow_name,",
				"          tcbgrow_preferredname,",
				"          tcbgrow_race",
				"     )) ~> sink1"
			]
		}
	}
}