{
	"name": "Schools Owners",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "p_schoolowners_d",
						"type": "DatasetReference"
					},
					"name": "parquetsource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DataverseSchoolOwners",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "alterRow1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> parquetsource",
				"filter1 alterRow(upsertIf(true())) ~> alterRow1",
				"parquetsource derive() ~> derivedColumn1",
				"derivedColumn1 filter(!isNull(tcbgrow_name) && startsWith(lower(tcbgrow_name), 'a')) ~> filter1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'tcbgrow_import_key',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     outputAssertFailedRows: true,",
				"     assertFailure_fileSystem: 'giraffe',",
				"     assertFailure_folderPath: 'errors',",
				"     mapColumn(",
				"          tcbgrow_breakeven,",
				"          tcbgrow_paymenttype = tcbgrow_paymenttypechoice,",
				"          tcbgrow_monthlysalaries,",
				"          tcbgrow_schoolstatus,",
				"          tcbgrow_contractdate,",
				"          tcbgrow_commencementdate,",
				"          tcbgrow_address,",
				"          tcbgrow_numberofclassrooms,",
				"          tcbgrow_name,",
				"          tcbgrow_growid,",
				"          tcbgrow_appid,",
				"          tcbgrow_capacity,",
				"          tcbgrow_appaccountcreationdate,",
				"          tcbgrow_centrestartdate,",
				"          {cog_City@odata.bind},",
				"          {tcbgrow_Country@odata.bind},",
				"          {tcbgrow_ECDOwner@odata.bind},",
				"          {tcbgrow_SchoolSegment@odata.bind},",
				"          {cog_Region@odata.bind}",
				"     )) ~> sink1"
			]
		}
	}
}