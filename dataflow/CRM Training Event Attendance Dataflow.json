{
	"name": "CRM Training Event Attendance Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet_Training_Event_Attendance",
						"type": "DatasetReference"
					},
					"name": "ParquetTrainingEventAttendance"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "CRM_Training_Event_Attendance",
						"type": "DatasetReference"
					},
					"name": "SinkTrainingEventAttendance"
				}
			],
			"transformations": [
				{
					"name": "Upsert"
				},
				{
					"name": "DerivedColumns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cog_giraffeid as long,",
				"          cog_trainingeventid as long,",
				"          cog_giraffeupdatedon as timestamp,",
				"          overriddencreatedon as timestamp,",
				"          cog_contact as integer,",
				"          cog_centreid as integer,",
				"          cog_applicationuser as integer,",
				"          cog_attendeeid as long,",
				"          cog_centrename as string,",
				"          cog_countryid as string,",
				"          cog_region as string,",
				"          cog_usertype as byte,",
				"          cog_recordedmobile as string,",
				"          cog_recordedemail as string,",
				"          cog_attendancestatuscode as byte,",
				"          cog_absencereason as string,",
				"          cog_roleateventcode as byte",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> ParquetTrainingEventAttendance",
				"DerivedColumns alterRow(upsertIf(true())) ~> Upsert",
				"ParquetTrainingEventAttendance derive({cog_CountryId@odata.bind} = iif(\r",
				"    isNull(cog_countryid),\r",
				"    toString(null()),\r",
				"    concat(\"/cog_countries(cog_countrycode='\",toString(cog_countryid),\"')\")\r",
				"),",
				"          {cog_Region@odata.bind} = iif(\r",
				"    isNull(cog_region),\r",
				"    toString(null()),\r",
				"    concat(\"/cog_regions(cog_regioncode='\",toString(cog_region),\"')\")\r",
				"),",
				"          {cog_Contact@odata.bind} = iif(     isNull(cog_contact),     toString(null()),     concat(\"/contacts(cog_giraffeprofileid=\",toString(cog_contact),\")\") ),",
				"          {cog_TrainingEventId@odata.bind} = iif(     isNull(cog_trainingeventid),     toString(null()),     concat(\"/cog_trainingevents(cog_giraffeid=\",toString(cog_trainingeventid),\")\") ),",
				"          {cog_CentreId@odata.bind} = iif(     isNull(cog_centreid),     toString(null()),     concat(\"/cog_accounts(cog_giraffeid=\",toString(cog_centreid),\")\") ),",
				"          {cog_ApplicationUser@odata.bind} = iif(     isNull(cog_applicationuser),     toString(null()),     concat(\"/cog_applicationusers(cog_giraffeid=\",toString(cog_applicationuser),\")\") ),",
				"          overriddencreatedon = toString(toUTC(overriddencreatedon, 'Africa/Johannesburg'), \"yyyy-MM-dd'T'HH:mm:ss'Z'\"),",
				"          cog_giraffeupdatedon = toString(toUTC(cog_giraffeupdatedon, 'Africa/Johannesburg'), \"yyyy-MM-dd'T'HH:mm:ss'Z'\")) ~> DerivedColumns",
				"Upsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'cog_giraffeid',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     mapColumn(",
				"          cog_giraffeid,",
				"          cog_giraffeupdatedon,",
				"          overriddencreatedon,",
				"          cog_centrename,",
				"          cog_usertype,",
				"          cog_recordedmobile,",
				"          cog_recordedemail,",
				"          cog_attendancestatuscode,",
				"          cog_absencereason,",
				"          cog_roleateventcode,",
				"          {cog_CountryId@odata.bind},",
				"          {cog_Region@odata.bind},",
				"          {cog_Contact@odata.bind},",
				"          {cog_TrainingEventId@odata.bind},",
				"          {cog_CentreId@odata.bind},",
				"          {cog_ApplicationUser@odata.bind}",
				"     )) ~> SinkTrainingEventAttendance"
			]
		}
	}
}