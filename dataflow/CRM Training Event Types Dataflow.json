{
	"name": "CRM Training Event Types Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet_Training_Event_Types",
						"type": "DatasetReference"
					},
					"name": "ParquetTrainingEventTypes"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "CRM_Training_Event_Types",
						"type": "DatasetReference"
					},
					"name": "SinkTrainingEventTypes"
				}
			],
			"transformations": [
				{
					"name": "Upsert"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cog_requirescoursename as boolean,",
				"          cog_requirescategory as boolean,",
				"          cog_giraffeid as integer,",
				"          cog_name as string,",
				"          cog_giraffeupdatedon as timestamp,",
				"          overriddencreatedon as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> ParquetTrainingEventTypes",
				"ParquetTrainingEventTypes alterRow(upsertIf(true())) ~> Upsert",
				"Upsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'cog_giraffeid',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     mapColumn(",
				"          cog_requirescoursename,",
				"          cog_requirescategory,",
				"          cog_giraffeid,",
				"          cog_name,",
				"          cog_giraffeupdatedon,",
				"          overriddencreatedon",
				"     ),",
				"     partitionBy('roundRobin', 10)) ~> SinkTrainingEventTypes"
			]
		}
	}
}