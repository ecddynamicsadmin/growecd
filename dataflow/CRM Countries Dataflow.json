{
	"name": "CRM Countries Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet_Countries",
						"type": "DatasetReference"
					},
					"name": "ParquetCountries"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "CRM_Countries",
						"type": "DatasetReference"
					},
					"name": "SinkCountries"
				}
			],
			"transformations": [
				{
					"name": "Upsert"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cog_countrycode as string,",
				"          cog_name as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> ParquetCountries",
				"ParquetCountries alterRow(upsertIf(true())) ~> Upsert",
				"Upsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'cog_countrycode',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     mapColumn(",
				"          cog_countrycode,",
				"          cog_name",
				"     ),",
				"     partitionBy('roundRobin', 10)) ~> SinkCountries"
			]
		}
	}
}