{
	"name": "School Expenses Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "p_schoolexpenses_d",
						"type": "DatasetReference"
					},
					"name": "parquetsource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DataverseSchoolIncomeExpenses",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "alterRow1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          tcbgrow_amount as long,",
				"          tcbgrow_asofdate as timestamp,",
				"          tcbgrow_description as string,",
				"          tcbgrow_importexpenseid as long,",
				"          tcbgrow_importschoolid as long,",
				"          tcbgrow_source as string,",
				"          tcbgrow_month as integer,",
				"          tcbgrow_year as string,",
				"          tcbgrow_transactiontype as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> parquetsource",
				"derivedColumn1 alterRow(upsertIf(true())) ~> alterRow1",
				"parquetsource derive({tcbgrow_School@odata.bind} = iif(    isNull(tcbgrow_importschoolid),    toString(null()),    concat(\"/tcbgrow_schools(tcbgrow_appid=\", toString(tcbgrow_importschoolid), \")\")),",
				"          tcbgrow_year = toString(tcbgrow_year)) ~> derivedColumn1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'tcbgrow_import_expense_key',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     outputAssertFailedRows: true,",
				"     assertFailure_fileSystem: 'giraffe',",
				"     assertFailure_folderPath: 'errors',",
				"     mapColumn(",
				"          tcbgrow_amount,",
				"          tcbgrow_asofdate,",
				"          tcbgrow_description,",
				"          tcbgrow_importexpenseid,",
				"          tcbgrow_importschoolid,",
				"          tcbgrow_source,",
				"          tcbgrow_month,",
				"          tcbgrow_year,",
				"          tcbgrow_transactiontype,",
				"          {tcbgrow_School@odata.bind}",
				"     )) ~> sink1"
			]
		}
	}
}