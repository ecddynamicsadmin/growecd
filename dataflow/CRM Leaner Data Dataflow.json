{
	"name": "CRM Leaner Data Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet_Learner_Data",
						"type": "DatasetReference"
					},
					"name": "ParquetLearnerData"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "CRM_Learner_Data",
						"type": "DatasetReference"
					},
					"name": "SinkLearnerData"
				}
			],
			"transformations": [
				{
					"name": "Upsert"
				},
				{
					"name": "DerivedColumns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cog_centreid as integer,",
				"          cog_name as string,",
				"          cog_learners0to2 as decimal(38,18),",
				"          cog_learners2to5 as decimal(38,18),",
				"          cog_learners6to9 as decimal(38,18),",
				"          cog_learners9plus as decimal(38,18),",
				"          cog_learnerstotal as decimal(38,18)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> ParquetLearnerData",
				"DerivedColumns alterRow(upsertIf(true())) ~> Upsert",
				"ParquetLearnerData derive({cog_Account@odata.bind} = iif(\r",
				"  isNull(cog_centreid),\r",
				"  toString(null()),\r",
				"  concat('/accounts(cog_centreid=', toString(toInteger(cog_centreid)), ')')\r",
				"),",
				"          overriddencreatedon = toString(currentUTC(), \"yyyy-MM-dd'T'HH:mm:ss'Z'\"),",
				"          cog_learners0to2 = toInteger(cog_learners0to2),",
				"          cog_learners2to5 = toInteger(cog_learners2to5),",
				"          cog_learners6to9 = toInteger(cog_learners6to9),",
				"          cog_learners9plus = toInteger(cog_learners9plus),",
				"          cog_learnerstotal = toInteger(cog_learnerstotal)) ~> DerivedColumns",
				"Upsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'cog_centreid',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     mapColumn(",
				"          cog_centreid,",
				"          cog_name,",
				"          cog_learners0to2,",
				"          cog_learners2to5,",
				"          cog_learners6to9,",
				"          cog_learners9plus,",
				"          cog_learnerstotal,",
				"          {cog_Account@odata.bind},",
				"          overriddencreatedon",
				"     ),",
				"     partitionBy('roundRobin', 10)) ~> SinkLearnerData"
			]
		}
	}
}