{
	"name": "CRM Leaner Data Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet_Learner_Data",
						"type": "DatasetReference"
					},
					"name": "ParquetLearnerData"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "CRM_Centres",
						"type": "DatasetReference"
					},
					"name": "SinkLearnerData"
				}
			],
			"transformations": [
				{
					"name": "Upsert"
				},
				{
					"name": "DerivedColumns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cog_centreid as integer,",
				"          cog_name as string,",
				"          cog_learners0to2 as decimal(38,18),",
				"          cog_learners2to5 as decimal(38,18),",
				"          cog_learners6to9 as decimal(38,18),",
				"          cog_learners9plus as decimal(38,18),",
				"          cog_learners_total as decimal(38,18)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> ParquetLearnerData",
				"DerivedColumns alterRow(upsertIf(true())) ~> Upsert",
				"ParquetLearnerData derive({cog_Account@odata.bind} = iif(\r",
				"  isNull(cog_centreid),\r",
				"  toString(null()),\r",
				"  concat('/accounts(cog_centreid=', toString(toInteger(cog_centreid)), ')')\r",
				")) ~> DerivedColumns",
				"Upsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'cog_centreid',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     mapColumn(",
				"          cog_centreid,",
				"          name,",
				"          address1_city,",
				"          address1_line1,",
				"          emailaddress1,",
				"          telephone1,",
				"          cog_centrestartdate,",
				"          cog_learnercapacity,",
				"          cog_classroomcount,",
				"          cog_ecdtypecode,",
				"          cog_agreementtypecode,",
				"          cog_giraffeupdatedon,",
				"          overriddencreatedon,",
				"          cog_programme,",
				"          cog_programmestatuscode,",
				"          cog_propertytypecode,",
				"          cog_centretypecode,",
				"          cog_classtypecode,",
				"          cog_operatinghours,",
				"          {cog_CountryId@odata.bind},",
				"          {cog_Region@odata.bind} = {cog_Account@odata.bind},",
				"          cog_centretypeother,",
				"          cog_propertytypeother",
				"     )) ~> SinkLearnerData"
			]
		}
	}
}