{
	"name": "CRM Centres Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet_Centres",
						"type": "DatasetReference"
					},
					"name": "ParquetCentres"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "CRM_Centres",
						"type": "DatasetReference"
					},
					"name": "SinkRegions"
				}
			],
			"transformations": [
				{
					"name": "Upsert"
				},
				{
					"name": "DeriveCountryLookup"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cog_centreid as integer,",
				"          name as string,",
				"          address1_city as string,",
				"          address1_line1 as string,",
				"          emailaddress1 as string,",
				"          telephone1 as string,",
				"          cog_centrestartdate as timestamp,",
				"          cog_learnercapacity as integer,",
				"          cog_classroomcount as integer,",
				"          cog_ecdtypecode as byte,",
				"          cog_agreementtype as byte,",
				"          cog_giraffeupdatedon as timestamp,",
				"          overriddencreatedon as timestamp,",
				"          cog_programme as boolean,",
				"          cog_programmestatus as byte,",
				"          cog_countryid as string,",
				"          cog_region as string,",
				"          cog_propertytype as string,",
				"          cog_centretype as string,",
				"          cog_classtype as string,",
				"          cog_operatinghours as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> ParquetCentres",
				"DeriveCountryLookup alterRow(upsertIf(true())) ~> Upsert",
				"ParquetCentres derive({cog_CountryId@odata.bind} = iif(\r",
				"    isNull(cog_countryid),\r",
				"    toString(null()),\r",
				"    concat(\"/cog_countries(cog_countrycode='\",toString(cog_countryid),\"')\")\r",
				"),",
				"          {cog_Region@odata.bind} = iif(\r",
				"    isNull(cog_region),\r",
				"    toString(null()),\r",
				"    concat(\"/cog_regionss(cog_regioncode='\",toString(cog_region),\"')\")\r",
				"),",
				"          cog_programme =   case(\r",
				"    isNull(cog_programme), 769070000,\r",
				"    cog_programme == true(), 769070001,\r",
				"    cog_programme == false(), 769070002\r",
				"  )\r",
				") ~> DeriveCountryLookup",
				"Upsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'cog_centreid',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     mapColumn(",
				"          cog_centreid,",
				"          name,",
				"          address1_city,",
				"          address1_line1,",
				"          emailaddress1,",
				"          telephone1,",
				"          cog_centrestartdate,",
				"          cog_learnercapacity,",
				"          cog_classroomcount,",
				"          cog_ecdtypecode,",
				"          cog_programmestatus,",
				"          cog_agreementtype,",
				"          cog_giraffeupdatedon,",
				"          overriddencreatedon,",
				"          cog_countryid,",
				"          cog_region,",
				"          cog_customersegment,",
				"          operating_hours_src,",
				"          cog_propertytype,",
				"          cog_centretype,",
				"          cog_classtype,",
				"          bind = {cog_CountryId@odata.bind},",
				"          bind = {cog_Region@odata.bind}",
				"     )) ~> SinkRegions"
			]
		}
	}
}