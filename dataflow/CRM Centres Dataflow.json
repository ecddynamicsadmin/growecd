{
	"name": "CRM Centres Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet_Centres",
						"type": "DatasetReference"
					},
					"name": "ParquetCentres"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "CRM_Centres",
						"type": "DatasetReference"
					},
					"name": "SinkRegions"
				}
			],
			"transformations": [
				{
					"name": "Upsert"
				},
				{
					"name": "DerivedColumns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cog_centreid as integer,",
				"          name as string,",
				"          address1_city as string,",
				"          address1_line1 as string,",
				"          emailaddress1 as string,",
				"          telephone1 as string,",
				"          cog_centrestartdate as timestamp,",
				"          cog_learnercapacity as integer,",
				"          cog_classroomcount as integer,",
				"          cog_ecdtypecode as byte,",
				"          cog_agreementtypecode as byte,",
				"          cog_giraffeupdatedon as timestamp,",
				"          overriddencreatedon as timestamp,",
				"          cog_programme as boolean,",
				"          cog_programmestatuscode as byte,",
				"          cog_countryid as string,",
				"          cog_region as string,",
				"          cog_propertytypecode as string,",
				"          cog_centretypecode as string,",
				"          cog_classtypecode as string,",
				"          cog_operatinghours as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> ParquetCentres",
				"DerivedColumns alterRow(upsertIf(true())) ~> Upsert",
				"ParquetCentres derive({cog_CountryId@odata.bind} = iif(\r",
				"    isNull(cog_countryid),\r",
				"    toString(null()),\r",
				"    concat(\"/cog_countries(cog_countrycode='\",toString(cog_countryid),\"')\")\r",
				"),",
				"          {cog_Region@odata.bind} = iif(\r",
				"    isNull(cog_region),\r",
				"    toString(null()),\r",
				"    concat(\"/cog_regionss(cog_regioncode='\",toString(cog_region),\"')\")\r",
				"),",
				"          cog_programme =   case(\r",
				"    isNull(cog_programme), 769070000,\r",
				"    cog_programme == true(), 769070001,\r",
				"    cog_programme == false(), 769070002\r",
				"  )\r",
				",",
				"          overriddencreatedon = toString(toUTC(overriddencreatedon, 'Africa/Johannesburg'), \"yyyy-MM-dd'T'HH:mm:ss'Z'\"),",
				"          cog_centrestartdate = toString(toDate(cog_centrestartdate), 'yyyy-MM-dd'),",
				"          cog_giraffeupdatedon = toString(toUTC(cog_giraffeupdatedon, 'Africa/Johannesburg'), \"yyyy-MM-dd'T'HH:mm:ss'Z'\"),",
				"          cog_classtypecode = iif(\r",
				"  isNull(cog_classtypecode) || regexReplace(toString(cog_classtypecode), '[\\\\[\\\\]\\\\s]', '') == '',\r",
				"  toString(null()),\r",
				"  reduce(\r",
				"    filter(\r",
				"      split(regexReplace(toString(cog_classtypecode), '[\\\\[\\\\]\\\\s]', ''), ','),\r",
				"      in(['1','2','3','4','5','6','7'], #item)\r",
				"    ),\r",
				"    '',\r",
				"    iif(#acc == '', #item, #acc + ',' + #item),\r",
				"    #result\r",
				"  )\r",
				")) ~> DerivedColumns",
				"Upsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'cog_centreid',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     mapColumn(",
				"          cog_centreid,",
				"          name,",
				"          address1_city,",
				"          address1_line1,",
				"          emailaddress1,",
				"          telephone1,",
				"          cog_centrestartdate,",
				"          cog_learnercapacity,",
				"          cog_classroomcount,",
				"          cog_ecdtypecode,",
				"          cog_agreementtypecode,",
				"          cog_giraffeupdatedon,",
				"          overriddencreatedon,",
				"          cog_programme,",
				"          cog_programmestatuscode,",
				"          cog_propertytypecode,",
				"          cog_centretypecode,",
				"          cog_classtypecode,",
				"          cog_operatinghours,",
				"          {cog_CountryId@odata.bind},",
				"          {cog_Region@odata.bind}",
				"     )) ~> SinkRegions"
			]
		}
	}
}