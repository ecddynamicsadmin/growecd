{
	"name": "CRM Centres Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet_app_users",
						"type": "DatasetReference"
					},
					"name": "ParquetAppUsers"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "CRM_Centres",
						"type": "DatasetReference"
					},
					"name": "SinkRegions"
				}
			],
			"transformations": [
				{
					"name": "Upsert"
				},
				{
					"name": "DerivedColumns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as long,",
				"          school_id as string,",
				"          franchisee_id as long,",
				"          region_id as long,",
				"          city_id as long,",
				"          province_id as long,",
				"          grow_id as string,",
				"          name as string,",
				"          learner_capacity as string,",
				"          number_of_classrooms as string,",
				"          logo as string,",
				"          address as string,",
				"          school_commencement_date as timestamp,",
				"          break_even_fee as integer,",
				"          capacity as integer,",
				"          form_11 as string,",
				"          hr_email as string,",
				"          hr_staff_code as string,",
				"          ecd_start_date as timestamp,",
				"          ecd_code as string,",
				"          contract as string,",
				"          contract_start_date as timestamp,",
				"          contract_end_date as timestamp,",
				"          business_mentor_id as decimal(38,0),",
				"          education_mentor_id as decimal(38,0),",
				"          business_mentor_name as string,",
				"          business_mentor_phone_number as string,",
				"          business_mentor_email as string,",
				"          education_mentor_name as string,",
				"          education_mentor_phone_number as string,",
				"          education_mentor_email as string,",
				"          hourly_late_or_early_fee as long,",
				"          created_by as integer,",
				"          updated_by as integer,",
				"          created_at as timestamp,",
				"          updated_at as timestamp,",
				"          school_status as string,",
				"          inventory_group_id as decimal(38,0),",
				"          monthly_salaries as decimal(38,18),",
				"          is_learner_payment as boolean,",
				"          is_learner_attendance as boolean,",
				"          is_learner_assessment as boolean,",
				"          is_caregiver_access as boolean,",
				"          segment as string,",
				"          agreement_type as string,",
				"          program_status as string,",
				"          owner_id as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> ParquetAppUsers",
				"DerivedColumns alterRow(upsertIf(true())) ~> Upsert",
				"ParquetAppUsers derive({cog_CountryId@odata.bind} = iif(\r",
				"    isNull(cog_countryid),\r",
				"    toString(null()),\r",
				"    concat(\"/cog_countries(cog_countrycode='\",toString(cog_countryid),\"')\")\r",
				"),",
				"          {cog_Region@odata.bind} = iif(\r",
				"    isNull(cog_region),\r",
				"    toString(null()),\r",
				"    concat(\"/cog_regions(cog_regioncode='\",toString(cog_region),\"')\")\r",
				"),",
				"          cog_programme = case(\r",
				"    isNull(cog_programme), 769070000,\r",
				"    cog_programme == true(), 769070001,\r",
				"    cog_programme == false(), 769070002\r",
				"  ),",
				"          overriddencreatedon = toString(toUTC(overriddencreatedon, 'Africa/Johannesburg'), \"yyyy-MM-dd'T'HH:mm:ss'Z'\"),",
				"          cog_centrestartdate = toString(toDate(cog_centrestartdate), 'yyyy-MM-dd'),",
				"          cog_giraffeupdatedon = toString(toUTC(cog_giraffeupdatedon, 'Africa/Johannesburg'), \"yyyy-MM-dd'T'HH:mm:ss'Z'\"),",
				"          cog_classtypecode = iif(\r",
				"  size(filter(split(regexReplace(toString(cog_classtypecode), '[\\\\[\\\\]\\\\s\"]', ''), ','), in(['1','2','3','4','5','6','7'], #item))) == 0,\r",
				"  toString(null()),\r",
				"  reduce(\r",
				"    filter(split(regexReplace(toString(cog_classtypecode), '[\\\\[\\\\]\\\\s\"]', ''), ','), in(['1','2','3','4','5','6','7'], #item)),\r",
				"    '',\r",
				"    iif(#acc == '', #item, #acc + ',' + #item),\r",
				"    #result\r",
				"  )\r",
				"),",
				"          cog_centretypecode = iif(\r",
				"  isNull(cog_centretypecode) || trim(toString(cog_centretypecode)) == '',\r",
				"  toInteger(null()),\r",
				"  iif(in(['1','2','3','4','5'], trim(toString(cog_centretypecode))),\r",
				"      toInteger(trim(toString(cog_centretypecode))),\r",
				"      6)\r",
				"),",
				"          cog_centretypeother = iif(\r",
				"  isNull(cog_centretypecode) || trim(toString(cog_centretypecode)) == '' || in(['1','2','3','4','5'], trim(toString(cog_centretypecode))),\r",
				"  toString(null()),\r",
				"  left(trim(toString(cog_centretypecode)), 255)\r",
				"),",
				"          cog_propertytypecode = iif(\r",
				"  isNull(cog_propertytypecode) || trim(toString(cog_propertytypecode)) == '',\r",
				"  toInteger(null()),\r",
				"  iif(in(['1','2','3'], trim(toString(cog_propertytypecode))),\r",
				"      toInteger(trim(toString(cog_propertytypecode))),\r",
				"      99)\r",
				"),",
				"          cog_propertytypeother = iif(\r",
				"  isNull(cog_propertytypecode) || trim(toString(cog_propertytypecode)) == '' || in(['1','2','3'], trim(toString(cog_propertytypecode))),\r",
				"  toString(null()),\r",
				"  left(trim(toString(cog_propertytypecode)), 255)\r",
				")) ~> DerivedColumns",
				"Upsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'cog_centreid',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     mapColumn(",
				"          cog_centreid,",
				"          name,",
				"          address1_city,",
				"          address1_line1,",
				"          emailaddress1,",
				"          telephone1,",
				"          cog_centrestartdate,",
				"          cog_learnercapacity,",
				"          cog_classroomcount,",
				"          cog_ecdtypecode,",
				"          cog_agreementtypecode,",
				"          cog_giraffeupdatedon,",
				"          overriddencreatedon,",
				"          cog_programme,",
				"          cog_programmestatuscode,",
				"          cog_propertytypecode,",
				"          cog_centretypecode,",
				"          cog_classtypecode,",
				"          cog_operatinghours,",
				"          {cog_CountryId@odata.bind},",
				"          {cog_Region@odata.bind},",
				"          cog_centretypeother,",
				"          cog_propertytypeother",
				"     )) ~> SinkRegions"
			]
		}
	}
}