{
	"name": "Schools Update",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "p_schoolsupdate_d",
						"type": "DatasetReference"
					},
					"name": "parquetsource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DataverseSchool",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "alterRow1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          address as string,",
				"          agreement_type as string,",
				"          break_even_fee as integer,",
				"          capacity as integer,",
				"          city_id as long,",
				"          contract_start_date as timestamp,",
				"          countryid as integer,",
				"          ecd_code as string,",
				"          id as long,",
				"          Importschool as boolean,",
				"          Importschooldone as boolean,",
				"          monthly_salaries as decimal(38,9),",
				"          name as string,",
				"          number_of_classrooms as string,",
				"          owner_id as long,",
				"          region_id as long,",
				"          school_commencement_date as timestamp,",
				"          school_id as string,",
				"          school_status as string,",
				"          segment as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> parquetsource",
				"derivedColumn1 alterRow(upsertIf(true())) ~> alterRow1",
				"select1 derive(tcbgrow_appaccountcreationdate = tcbgrow_contractdate,",
				"          {column1tcbgrow_country.tcbgrow_appid} = tcbgrow_importcountryid,",
				"          tcbgrow_centrestartdate = tcbgrow_commencementdate) ~> derivedColumn1",
				"parquetsource select(mapColumn(",
				"          tcbgrow_address = address,",
				"          tcbgrow_paymenttype = agreement_type,",
				"          tcbgrow_breakeven = break_even_fee,",
				"          tcbgrow_capacity = capacity,",
				"          tcbgrow_importcityid = city_id,",
				"          tcbgrow_contractdate = contract_start_date,",
				"          tcbgrow_importcountryid = countryid,",
				"          tcbgrow_importecdcode = ecd_code,",
				"          tcbgrow_appid = id,",
				"          tcbgrow_schoolimport = Importschool,",
				"          tcbgrow_schoolimportdone = Importschooldone,",
				"          tcbgrow_monthlysalaries = monthly_salaries,",
				"          tcbgrow_name = name,",
				"          tcbgrow_numberofclassrooms = number_of_classrooms,",
				"          {tcbgrow_ecdowner.tcbgrow_appid} = owner_id,",
				"          tcbgrow_importprovinceid = region_id,",
				"          tcbgrow_commencementdate = school_commencement_date,",
				"          tcbgrow_growid = school_id,",
				"          tcbgrow_schoolstatus = school_status,",
				"          tcbgrow_tcbgrow_importsegment = segment",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'tcbgrow_import_key',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          tcbgrow_address,",
				"          tcbgrow_paymenttype,",
				"          tcbgrow_breakeven,",
				"          tcbgrow_capacity,",
				"          tcbgrow_importcityid,",
				"          tcbgrow_contractdate,",
				"          tcbgrow_importcountryid,",
				"          tcbgrow_importecdcode,",
				"          tcbgrow_appid,",
				"          tcbgrow_schoolimport,",
				"          tcbgrow_schoolimportdone,",
				"          tcbgrow_monthlysalaries,",
				"          tcbgrow_name,",
				"          tcbgrow_numberofclassrooms,",
				"          tcbgrow_appid = {tcbgrow_ecdowner.tcbgrow_appid},",
				"          tcbgrow_importprovinceid,",
				"          tcbgrow_commencementdate,",
				"          tcbgrow_growid,",
				"          tcbgrow_schoolstatus,",
				"          tcbgrow_tcbgrow_importsegment,",
				"          tcbgrow_appaccountcreationdate,",
				"          tcbgrow_appid = {column1tcbgrow_country.tcbgrow_appid},",
				"          tcbgrow_centrestartdate",
				"     )) ~> sink1"
			]
		}
	}
}