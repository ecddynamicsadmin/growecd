{
	"name": "Schools Update",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "p_schoolsupdate_d",
						"type": "DatasetReference"
					},
					"name": "parquetsource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DataverseSchool",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          tcbgrow_Address as string,",
				"          tcbgrow_PaymentType as string,",
				"          tcbgrow_BreakEven as integer,",
				"          tcbgrow_Capacity as integer,",
				"          tcbgrow_ImportCityId as long,",
				"          tcbgrow_AppAccountCreationDate as timestamp,",
				"          {tcbgrow_Country.tcbgrow_AppID} as integer,",
				"          tcbgrow_ImportECDCode as string,",
				"          tcbgrow_AppID as long,",
				"          tcbgrow_SchoolImport as boolean,",
				"          tcbgrow_SchoolImportDone as boolean,",
				"          tcbgrow_MonthlySalaries as decimal(38,9),",
				"          tcbgrow_Name as string,",
				"          tcbgrow_NumberofClassrooms as string,",
				"          {tcbgrow_ECDOwner.tcbgrow_AppId} as long,",
				"          tcbgrow_ImportProvinceId as long,",
				"          tcbgrow_CentreStartDate as timestamp,",
				"          tcbgrow_GrowID as string,",
				"          tcbgrow_SchoolStatus as string,",
				"          tcbgrow_tcbgrow_importsegment as string,",
				"          tcbgrow_ContractDate as timestamp,",
				"          tcbgrow_ImportCountryId as integer,",
				"          tcbgrow_ImportSchoolOwnerID as long,",
				"          tcbgrow_CommencementDate as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> parquetsource",
				"parquetsource select(mapColumn(",
				"          tcbgrow_Address,",
				"          tcbgrow_PaymentType,",
				"          tcbgrow_BreakEven,",
				"          tcbgrow_Capacity,",
				"          tcbgrow_ImportCityId,",
				"          tcbgrow_AppAccountCreationDate,",
				"          {tcbgrow_Country.tcbgrow_AppID},",
				"          tcbgrow_ImportECDCode,",
				"          tcbgrow_appid = tcbgrow_AppID,",
				"          tcbgrow_SchoolImport,",
				"          tcbgrow_SchoolImportDone,",
				"          tcbgrow_MonthlySalaries,",
				"          tcbgrow_Name,",
				"          tcbgrow_NumberofClassrooms,",
				"          {tcbgrow_ECDOwner.tcbgrow_AppId},",
				"          tcbgrow_ImportProvinceId,",
				"          tcbgrow_CentreStartDate,",
				"          tcbgrow_GrowID,",
				"          tcbgrow_SchoolStatus,",
				"          tcbgrow_tcbgrow_importsegment,",
				"          tcbgrow_ContractDate,",
				"          tcbgrow_ImportCountryId,",
				"          tcbgrow_ImportSchoolOwnerID,",
				"          tcbgrow_CommencementDate",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 alterRow(upsertIf(!isNull(tcbgrow_appid))) ~> alterRow1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'tcbgrow_import_key',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          tcbgrow_Address,",
				"          tcbgrow_PaymentType,",
				"          tcbgrow_BreakEven,",
				"          tcbgrow_Capacity,",
				"          tcbgrow_ImportCityId,",
				"          tcbgrow_AppAccountCreationDate,",
				"          tcbgrow_AppID = {tcbgrow_Country.tcbgrow_AppID},",
				"          tcbgrow_ImportECDCode,",
				"          tcbgrow_import_key = tcbgrow_appid,",
				"          tcbgrow_SchoolImport,",
				"          tcbgrow_SchoolImportDone,",
				"          tcbgrow_MonthlySalaries,",
				"          tcbgrow_Name,",
				"          tcbgrow_NumberofClassrooms,",
				"          tcbgrow_AppId = {tcbgrow_ECDOwner.tcbgrow_AppId},",
				"          tcbgrow_ImportProvinceId,",
				"          tcbgrow_CentreStartDate,",
				"          tcbgrow_GrowID,",
				"          tcbgrow_SchoolStatus,",
				"          tcbgrow_tcbgrow_importsegment,",
				"          tcbgrow_ContractDate,",
				"          tcbgrow_ImportCountryId,",
				"          tcbgrow_ImportSchoolOwnerID,",
				"          tcbgrow_CommencementDate",
				"     )) ~> sink1"
			]
		}
	}
}