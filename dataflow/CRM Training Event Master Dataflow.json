{
	"name": "CRM Training Event Master Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet_Training_Event_Master",
						"type": "DatasetReference"
					},
					"name": "ParquetTrainingEventMAster"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "CRM_Training_Event_Master",
						"type": "DatasetReference"
					},
					"name": "SinkTrainingEventMaster"
				}
			],
			"transformations": [
				{
					"name": "Upsert"
				},
				{
					"name": "DerivedColumns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cog_yearintroduced as integer,",
				"          cog_category as string,",
				"          cog_giraffeid as integer,",
				"          cog_eventtypeid as integer,",
				"          cog_name as string,",
				"          cog_giraffeupdatedon as timestamp,",
				"          overriddencreatedon as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> ParquetTrainingEventMAster",
				"DerivedColumns alterRow(upsertIf(true())) ~> Upsert",
				"ParquetTrainingEventMAster derive({cog_EventTypeId@odata.bind} = iif(\r",
				"    isNull(cog_eventtypeid),\r",
				"    toString(null()),\r",
				"    concat(\"/cog_trainingeventtypes(cog_giraffeid=\",toString(cog_eventtypeid),\")\")\r",
				")) ~> DerivedColumns",
				"Upsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     alternateKeyName: 'cog_giraffeid',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     mapColumn(",
				"          cog_yearintroduced,",
				"          cog_category,",
				"          cog_giraffeid,",
				"          cog_name,",
				"          cog_giraffeupdatedon,",
				"          overriddencreatedon,",
				"          {cog_EventTypeId@odata.bind}",
				"     )) ~> SinkTrainingEventMaster"
			]
		}
	}
}