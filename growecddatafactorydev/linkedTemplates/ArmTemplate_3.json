{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "growecddatafactorydev"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/GrowECD Master')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "ECD Owners",
						"type": "ExecutePipeline",
						"dependsOn": [],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "School Owners",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"LastRunDate": {
									"value": "@pipeline().parameters.LastRunDate",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "Schools",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "ECD Owners",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "School Update",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"LastRunDate": {
									"value": "@pipeline().parameters.LastRunDate",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "Staff",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "Schools",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "Schools Staff",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"LastRunDate": {
									"value": "@pipeline().parameters.LastRunDate",
									"type": "Expression"
								}
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"LastRunDate": {
						"type": "string",
						"defaultValue": "@formatDateTime(addHours(addDays(trigger().scheduledTime,-1),2),'yyyy-MM-dd HH:mm:ss')"
					}
				},
				"annotations": []
			},
			"dependsOn": []
		}
	]
}