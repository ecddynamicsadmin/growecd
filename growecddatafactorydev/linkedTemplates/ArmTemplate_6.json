						"pipelineReference": {
							"referenceName": "Giraffe Files",
							"type": "PipelineReference"
						},
						"parameters": {}
					}
				],
				"type": "ScheduleTrigger",
				"typeProperties": {
					"recurrence": {
						"frequency": "Hour",
						"interval": 1,
						"startTime": "2026-02-20T04:36:00",
						"endTime": "2026-02-21T04:36:00",
						"timeZone": "South Africa Standard Time"
					}
				}
			},
			"dependsOn": []
