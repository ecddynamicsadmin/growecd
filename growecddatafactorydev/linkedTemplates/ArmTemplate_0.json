			"type": "string",
			"defaultValue": "102.130.112.164"
		},
		"mysql_crm_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "crm"
		},
		"mysql_crm_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "cognate"
		},
		"mysql_growecd_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "102.130.112.164"
		},
		"mysql_growecd_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "growecd_growecd"
		},
		"mysql_growecd_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "cognate"
		}
