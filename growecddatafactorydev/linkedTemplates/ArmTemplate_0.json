		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "growecddatafactorydev"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"Dataverse1_servicePrincipalCredential": {
			"type": "secureString",
			"metadata": "Secure string for 'servicePrincipalCredential' of 'Dataverse1'"
		},
		"mysql_crm_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'mysql_crm'"
		},
		"mysql_growecd_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'mysql_growecd'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://growecdstorage.dfs.core.windows.net/"
		},
