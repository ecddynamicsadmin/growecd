{
	"name": "CRM Learner Data",
	"properties": {
		"activities": [
			{
				"name": "Learner Data from Giraffe",
				"type": "Copy",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "MariaDBSource",
						"query": "SELECT\n    l.centreid AS cog_centreid,\n    c.name     AS cog_name,\n    SUM(CASE WHEN TIMESTAMPDIFF(YEAR, l.birthdate, CURDATE()) BETWEEN 0 AND 1 THEN 1 ELSE 0 END) AS cog_learners0to2,\n    SUM(CASE WHEN TIMESTAMPDIFF(YEAR, l.birthdate, CURDATE()) BETWEEN 2 AND 5 THEN 1 ELSE 0 END) AS cog_learners2to5,\n    SUM(CASE WHEN TIMESTAMPDIFF(YEAR, l.birthdate, CURDATE()) BETWEEN 6 AND 8 THEN 1 ELSE 0 END) AS cog_learners6to9,\n    SUM(CASE WHEN TIMESTAMPDIFF(YEAR, l.birthdate, CURDATE()) >= 9            THEN 1 ELSE 0 END) AS cog_learners9plus,\n    SUM(CASE WHEN TIMESTAMPDIFF(YEAR, l.birthdate, CURDATE()) >= 0            THEN 1 ELSE 0 END) AS cog_learners_total\nFROM growecd.learners AS l\nLEFT JOIN growecd.centres AS c\n       ON c.centreid = l.centreid\nWHERE COALESCE(l.archived, 0) <> 1\nGROUP BY l.centreid, c.name\nORDER BY l.centreid;"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "cog_centreid",
									"type": "Int32",
									"physicalType": "Int32"
								},
								"sink": {
									"name": "cog_centreid",
									"type": "Int32",
									"physicalType": "INT_32"
								}
							},
							{
								"source": {
									"name": "cog_name",
									"type": "String",
									"physicalType": "VarChar"
								},
								"sink": {
									"name": "cog_name",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "cog_learners0to2",
									"type": "Decimal",
									"physicalType": "NewDecimal"
								},
								"sink": {
									"name": "cog_learners0to2",
									"type": "Decimal",
									"physicalType": "DECIMAL"
								}
							},
							{
								"source": {
									"name": "cog_learners2to5",
									"type": "Decimal",
									"physicalType": "NewDecimal"
								},
								"sink": {
									"name": "cog_learners2to5",
									"type": "Decimal",
									"physicalType": "DECIMAL"
								}
							},
							{
								"source": {
									"name": "cog_learners6to9",
									"type": "Decimal",
									"physicalType": "NewDecimal"
								},
								"sink": {
									"name": "cog_learners6to9",
									"type": "Decimal",
									"physicalType": "DECIMAL"
								}
							},
							{
								"source": {
									"name": "cog_learners9plus",
									"type": "Decimal",
									"physicalType": "NewDecimal"
								},
								"sink": {
									"name": "cog_learners9plus",
									"type": "Decimal",
									"physicalType": "DECIMAL"
								}
							},
							{
								"source": {
									"name": "cog_learners_total",
									"type": "Decimal",
									"physicalType": "NewDecimal"
								},
								"sink": {
									"name": "cog_learners_total",
									"type": "Decimal",
									"physicalType": "DECIMAL"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "Source_Learners",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "Parquet_Learner_Data",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "CRM Learner Data",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "Learner Data from Giraffe",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "CRM Leaner Data Dataflow",
						"type": "DataFlowReference"
					},
					"integrationRuntime": {
						"referenceName": "GrowECD-IRR",
						"type": "IntegrationRuntimeReference"
					},
					"traceLevel": "Fine"
				}
			}
		],
		"folder": {
			"name": "G2"
		},
		"annotations": []
	}
}