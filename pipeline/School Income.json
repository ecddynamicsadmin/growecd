{
	"name": "School Income",
	"properties": {
		"activities": [
			{
				"name": "School Income from Maria",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "MariaDBSource",
						"query": {
							"value": "SELECT * FROM vw_schoolincome_3months WHERE date_paid >= @{pipeline().parameters.WatermarkDate}",
							"type": "Expression"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "MariaSchoolIncome",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "p_schoolincome_s",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "School Income Query",
				"type": "ExecuteWranglingDataflow",
				"dependsOn": [
					{
						"activity": "School Income from Maria",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "School Salaries",
						"type": "DataFlowReference"
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"queries": [
						{
							"queryName": "UserQuery",
							"dataflowSinks": [
								{
									"name": "UserQuerypschoolsalariesd",
									"dataset": {
										"referenceName": "p_schoolsalaries_d",
										"type": "DatasetReference"
									},
									"script": "sink(allowSchemaDrift: true,\n\tvalidateSchema: false,\n\tinput(\n\t\ttcbgrow_amount as long,\n\t\ttcbgrow_asofdate as timestamp,\n\t\ttcbgrow_importsalaryid as long,\n\t\ttcbgrow_importschoolid as long,\n\t\ttcbgrow_month as integer,\n\t\ttcbgrow_year as integer,\n\t\ttcbgrow_description as string,\n\t\ttcbgrow_transactiontype as long\n\t),\n\tformat: 'parquet',\n\tpartitionFileNames:['p_schoolsalaries_d.parquet'],\n\tumask: 0022,\n\tpreCommands: [],\n\tpostCommands: [],\n\tskipDuplicateMapInputs: true,\n\tskipDuplicateMapOutputs: true,\n\tpartitionBy('hash', 1)) ~> UserQuerypschoolsalariesd"
								}
							]
						}
					]
				}
			},
			{
				"name": "School Income Update",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "School Income Query",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "School Salaries Dataflow",
						"type": "DataFlowReference"
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			}
		],
		"parameters": {
			"WatermarkDate": {
				"type": "string",
				"defaultValue": "'2026-03-12 16:45:28'"
			}
		},
		"annotations": []
	}
}