{
	"name": "CRM Training Event Master",
	"properties": {
		"activities": [
			{
				"name": "Event Master from Giraffe",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "MariaDBSource",
						"query": {
							"value": "SELECT\n    year_introduced          AS cog_yearintroduced,\n    category                    AS cog_category,\n    eventmasterid               AS cog_giraffeid,\n    eventtypeid               AS  cog_eventtypeid,\n    course_name                      AS cog_name,\n    updated_at                AS cog_giraffeupdatedon,\n    created_at                AS overriddencreatedon   \n\nFROM growecd.cms_event_master\nWHERE updated_at >= '@{pipeline().parameters.WatermarkDate}'\n  AND updated_at < CURDATE();\n",
							"type": "Expression"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "cog_yearintroduced",
									"type": "Int32",
									"physicalType": "Year"
								},
								"sink": {
									"name": "cog_yearintroduced",
									"type": "Int32",
									"physicalType": "INT_32"
								}
							},
							{
								"source": {
									"name": "cog_category",
									"type": "String",
									"physicalType": "VarChar"
								},
								"sink": {
									"name": "cog_category",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "cog_giraffeid",
									"type": "Int32",
									"physicalType": "Int32"
								},
								"sink": {
									"name": "cog_giraffeid",
									"type": "Int32",
									"physicalType": "INT_32"
								}
							},
							{
								"source": {
									"name": "cog_eventtypeid",
									"type": "Int16",
									"physicalType": "Int16"
								},
								"sink": {
									"name": "cog_eventtypeid",
									"type": "Int16",
									"physicalType": "INT_32"
								}
							},
							{
								"source": {
									"name": "cog_name",
									"type": "String",
									"physicalType": "VarChar"
								},
								"sink": {
									"name": "cog_name",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "cog_giraffeupdatedon",
									"type": "DateTime",
									"physicalType": "Timestamp"
								},
								"sink": {
									"name": "cog_giraffeupdatedon",
									"type": "DateTime",
									"physicalType": "INT_96"
								}
							},
							{
								"source": {
									"name": "overriddencreatedon",
									"type": "DateTime",
									"physicalType": "Timestamp"
								},
								"sink": {
									"name": "overriddencreatedon",
									"type": "DateTime",
									"physicalType": "INT_96"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "Source_Training_Event_Master",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "Parquet_Training_Event_Master",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "CRM Event Master",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "Event Master from Giraffe",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "CRM Training Event Master Dataflow",
						"type": "DataFlowReference"
					},
					"integrationRuntime": {
						"referenceName": "GrowECD-IRR",
						"type": "IntegrationRuntimeReference"
					},
					"traceLevel": "Fine"
				}
			}
		],
		"parameters": {
			"WatermarkDate": {
				"type": "string",
				"defaultValue": "2026-04-05 16:45:28"
			}
		},
		"folder": {
			"name": "G2"
		},
		"annotations": []
	}
}