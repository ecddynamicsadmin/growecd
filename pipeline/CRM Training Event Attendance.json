{
	"name": "CRM Training Event Attendance",
	"properties": {
		"activities": [
			{
				"name": "Event Attendance from Giraffe",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "MariaDBSource",
						"query": {
							"value": "SELECT\n    a.attendanceid            AS cog_giraffeid,\n    a.eventid                 AS cog_trainingeventid,\n    a.updated_at              AS cog_giraffeupdatedon,\n    a.created_at              AS overriddencreatedon,\n    a.profileid               AS cog_contact,\n    a.centreid                AS cog_centreid,\n    a.userid                  AS cog_applicationuser,\n    a.attendeeid              AS cog_attendeeid,\n    a.centre_name             AS cog_centrename,\n    a.countrycode             AS cog_countryid,\n    a.regioncode              AS cog_region,\n    a.usertype                AS cog_usertype,\n    a.recorded_mobilenumber   AS cog_recordedmobilenumber,\n    a.recorded_email          AS cog_recordedemail,\n    a.status                  AS cog_attendancestatuscode,\n    a.absence_reason          AS cog_absencereason,\n    a.usertype                AS cog_roleateventcode\nFROM growecd.cms_event_attendance AS a\nINNER JOIN growecd.cms_events AS e\n        ON e.eventid = a.eventid\nLEFT JOIN growecd.centres AS c\n       ON c.centreid = a.centreid\nWHERE LEFT(e.title, 18) = 'Accelerator_Module'\n  AND COALESCE(c.is_test, 0) <> 1\n  AND COALESCE(a.usertype, 0) <> 20\n  AND a.updated_at >= '@{formatDateTime(pipeline().parameters.WatermarkDate, 'yyyy-MM-dd HH:mm:ss')}'\n  AND a.updated_at <  CURDATE()",
							"type": "Expression"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "cog_giraffeid",
									"type": "Int64",
									"physicalType": "Int64"
								},
								"sink": {
									"name": "cog_giraffeid",
									"type": "Int64",
									"physicalType": "INT_64"
								}
							},
							{
								"source": {
									"name": "cog_trainingeventid",
									"type": "Int64",
									"physicalType": "Int64"
								},
