									"name": "cog_centreid",
									"type": "Int32",
									"physicalType": "Int32"
								},
								"sink": {
									"name": "cog_centreid",
									"type": "Int32",
									"physicalType": "INT_32"
								}
							},
							{
								"source": {
									"name": "cog_applicationuser",
									"type": "Int32",
									"physicalType": "Int32"
								},
								"sink": {
									"name": "cog_applicationuser",
									"type": "Int32",
									"physicalType": "INT_32"
								}
							},
							{
