									"type": "DateTime",
									"physicalType": "Timestamp"
								},
								"sink": {
									"name": "cog_giraffeupdatedon",
									"type": "DateTime",
									"physicalType": "INT_96"
								}
							},
							{
								"source": {
									"name": "overriddencreatedon",
									"type": "DateTime",
									"physicalType": "Timestamp"
								},
								"sink": {
									"name": "overriddencreatedon",
									"type": "DateTime",
									"physicalType": "INT_96"
								}
							},
							{
