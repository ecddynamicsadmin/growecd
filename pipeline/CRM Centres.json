									"physicalType": "Date"
								},
								"sink": {
									"name": "cog_centrestartdate",
									"type": "DateTime",
									"physicalType": "INT_96"
								}
							},
							{
								"source": {
									"name": "cog_learnercapacity",
									"type": "Int16",
									"physicalType": "Int16"
								},
								"sink": {
									"name": "cog_learnercapacity",
									"type": "Int16",
									"physicalType": "INT_32"
								}
							},
							{
								"source": {
									"name": "cog_classroomcount",
									"type": "Int16",
									"physicalType": "Int16"
								},
								"sink": {
