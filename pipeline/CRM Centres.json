									"physicalType": "VarChar"
								},
								"sink": {
									"name": "address1_line1",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "emailaddress1",
									"type": "String",
									"physicalType": "VarChar"
								},
								"sink": {
									"name": "emailaddress1",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "telephone1",
									"type": "String",
									"physicalType": "VarChar"
								},
								"sink": {
									"name": "telephone1",
