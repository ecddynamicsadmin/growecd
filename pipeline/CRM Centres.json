								},
								"sink": {
									"name": "cog_classtype",
									"type": "String",
									"physicalType": "UTF8"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "Source_Centres",
						"type": "DatasetReference"
					}
				],
				"outputs": [
