							"value": "SELECT\n    mobilenumber                AS mobilephone,\n    email                       AS emailaddress1,\n    firstname                   AS firstname,\n    lastname                    AS lastname,\n    birthdate                   AS birthdate,\n    gender                      AS cog_gendercode,\n    race                        AS cog_racecode,\n    race_text                   AS cog_raceother,\n    city                        AS address1_city,\n    physical_address            AS address1_line1,\n    countrycode                 AS cog_countryid,\n    regioncode                  AS cog_region,\n    profileid                   AS cog_giraffeprofileid,\n    centreid                    AS cog_centreid,\n    usertype                    AS cog_rolecode,\n    start_date                  AS cog_startdate,\n    child_protection            AS cog_childprotectionclearancecode,\n    employment_type             AS cog_employmenttypecode,\n    qualification               AS cog_highestqualificationcode,\n    work_hours_total            AS cog_workhourstotal,\n    updated_at                 AS cog_giraffeupdatedon,\n    created_at                 AS overriddencreatedon,\n    userid                     AS cog_applicationuser   \n\nFROM growecd.centre_profiles\nWHERE updated_at >= '@{formatDateTime(pipeline().parameters.WatermarkDate, 'yyyy-MM-dd HH:mm:ss')}'\n  AND COALESCE(usertype, 0) <> 20",
							"type": "Expression"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
