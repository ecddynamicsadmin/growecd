{
	"name": "CRM Training Event Types",
	"properties": {
		"activities": [
			{
				"name": "Event Types from Giraffe",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "MariaDBSource",
						"query": {
							"value": "SELECT\n    requires_course_name      AS requirescoursename,\n    requires_category         AS cog_requirescategory,\n    eventtypeid               AS cog_giraffeid,\n    name                      AS cog_name,\n    centreid                  AS cog_centreid,\n    updated_at                AS cog_giraffeupdatedon,\n    created_at                AS overriddencreatedon   \n\nFROM growecd.cms_event_types\nWHERE updated_at >= '@{pipeline().parameters.WatermarkDate}'\n  AND updated_at < CURDATE();\n\n\n",
							"type": "Expression"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "Source_Training_Event_Types",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "Parquet_Training_Event_Types",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "CRM Event Types",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "Event Types from Giraffe",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "CRM Training Event Types Dataflow",
						"type": "DataFlowReference"
					},
					"integrationRuntime": {
						"referenceName": "GrowECD-IRR",
						"type": "IntegrationRuntimeReference"
					},
					"traceLevel": "Fine"
				}
			}
		],
		"parameters": {
			"WatermarkDate": {
				"type": "string",
				"defaultValue": "2026-04-05 16:45:28"
			}
		},
		"folder": {
			"name": "G2"
		},
		"annotations": []
	}
}