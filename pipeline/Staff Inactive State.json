{
	"name": "pipeline1",
	"properties": {
		"activities": [
			{
				"name": "CopyInactiveStaffIdsToChunks",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "DeleteOldContactChunks",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "ParquetSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "ParquetReadSettings"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "p_schoolstaff_d",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "p_schoolstaff_d_inactive",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "DeleteOldContactChunks",
				"type": "Delete",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "Contacts_Json_InactiveChunkFolder",
						"type": "DatasetReference",
						"parameters": {
							"Container": "giraffe",
							"FolderPath": "staging/contact_inactive_chunks"
						}
					},
					"enableLogging": false,
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"wildcardFileName": "*.json",
						"enablePartitionDiscovery": false
					}
				}
			}
		],
		"annotations": []
	}
}