{
	"name": "CRM Training Events",
	"properties": {
		"activities": [
			{
				"name": "Events from Giraffe",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "MariaDBSource",
						"query": {
							"value": "SELECT\n    title                     AS cog_name,\n    event_date                AS cog_eventdate,\n    eventid                   AS cog_giraffeid,\n    eventmasterid             AS cog_eventmasterid,\n    updated_at                AS cog_giraffeupdatedon,\n    created_at                AS overriddencreatedon,   \n    facilitator               AS cog_facilitator, \n    venue                     AS cog_venue  \n\nFROM growecd.cms_events\nWHERE updated_at >= '@{pipeline().parameters.WatermarkDate}'\n  AND updated_at < CURDATE();\n\n\n\n\n",
							"type": "Expression"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "cog_name",
									"type": "String",
									"physicalType": "VarChar"
								},
								"sink": {
									"name": "cog_name",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "cog_eventdate",
									"type": "DateTime",
									"physicalType": "Date"
								},
								"sink": {
									"name": "cog_eventdate",
									"type": "DateTime",
									"physicalType": "INT_96"
								}
							},
							{
								"source": {
									"name": "cog_giraffeid",
									"type": "Int64",
									"physicalType": "Int64"
								},
								"sink": {
									"name": "cog_giraffeid",
									"type": "Int64",
									"physicalType": "INT_64"
								}
							},
							{
								"source": {
									"name": "cog_eventmasterid",
									"type": "Int32",
									"physicalType": "Int32"
								},
								"sink": {
									"name": "cog_eventmasterid",
									"type": "Int32",
									"physicalType": "INT_32"
								}
							},
							{
								"source": {
									"name": "cog_giraffeupdatedon",
									"type": "DateTime",
									"physicalType": "Timestamp"
								},
								"sink": {
									"name": "cog_giraffeupdatedon",
									"type": "DateTime",
									"physicalType": "INT_96"
								}
							},
							{
								"source": {
									"name": "overriddencreatedon",
									"type": "DateTime",
									"physicalType": "Timestamp"
								},
								"sink": {
									"name": "overriddencreatedon",
									"type": "DateTime",
									"physicalType": "INT_96"
								}
							},
							{
								"source": {
									"name": "cog_facilitator",
									"type": "String",
									"physicalType": "VarChar"
								},
								"sink": {
									"name": "cog_facilitator",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "cog_venue",
									"type": "String",
									"physicalType": "VarChar"
								},
								"sink": {
									"name": "cog_venue",
									"type": "String",
									"physicalType": "UTF8"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "Source_Training_Events",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "Parquet_Training_Events",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "CRM Events",
				"type": "ExecuteDataFlow",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Events from Giraffe",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "CRM Training Events Dataflow",
						"type": "DataFlowReference"
					},
					"integrationRuntime": {
						"referenceName": "GrowECD-IRR",
						"type": "IntegrationRuntimeReference"
					},
					"traceLevel": "Fine"
				}
			}
		],
		"parameters": {
			"WatermarkDate": {
				"type": "string",
				"defaultValue": "2026-04-05 16:45:28"
			}
		},
		"folder": {
			"name": "G2"
		},
		"annotations": []
	}
}