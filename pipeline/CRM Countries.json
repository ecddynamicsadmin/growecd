{
	"name": "CRM Countries",
	"properties": {
		"activities": [
			{
				"name": "Countries from Giraffe",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "MariaDBSource",
						"query": "SELECT\n    countrycode  AS cog_countrycode,   -- make this the alternate key and upsert on it\n    country      AS cog_name\nFROM growecd.countries;"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "cog_countrycode",
									"type": "String",
									"physicalType": "VarChar"
								},
								"sink": {
									"name": "cog_countrycode",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "cog_name",
									"type": "String",
									"physicalType": "VarChar"
								},
								"sink": {
									"name": "cog_name",
									"type": "String",
									"physicalType": "UTF8"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "Source_Countries",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "Parquet_Countries",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "CRM Countries",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "Countries from Giraffe",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "CRM Countries Dataflow",
						"type": "DataFlowReference"
					},
					"integrationRuntime": {
						"referenceName": "GrowECD-IRR",
						"type": "IntegrationRuntimeReference"
					},
					"traceLevel": "Fine"
				}
			}
		],
		"folder": {
			"name": "G2"
		},
		"annotations": []
	}
}